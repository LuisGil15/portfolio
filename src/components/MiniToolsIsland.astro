    const interval=window.setInterval(()=>{if(playing){elapsed=(elapsed+1)%213;renderMusic();}if(running){remaining=Math.max(0,Math.ceil((deadline-Date.now())/1000));if(!remaining)showTimerAlert();else renderTimer();}},1000);
