    q<HTMLInputElement>('[data-progress]').addEventListener('input',e=>{elapsed=Number((e.target as HTMLInputElement).value);renderMusic();});
    function toggleTimer(){if(remaining===0)remaining=duration;running=!running;deadline=Date.now()+remaining*1000;renderTimer();}
    q('[data-timer-toggle]').addEventListener('click',toggleTimer);q('[data-peek-timer-toggle]').addEventListener('click',toggleTimer);
    q('[data-peek-timer-cancel]').addEventListener('click',()=>{running=false;remaining=duration;closeCompact();renderTimer();q('[data-island-toggle]').focus();});
