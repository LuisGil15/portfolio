---
import T from './ProposalText.astro';
import Icon from './MiniToolsIcon.astro';
const activities = [
 {id:'music',icon:'music',en:'Listen',es:'Escucha',body:'Your music, a little closer.',cuerpo:'Tu música, un poco más cerca.'},
 {id:'timers',icon:'timer',en:'Focus',es:'Concéntrate',body:'Make room for one thing.',cuerpo:'Haz espacio para una cosa.'},
 {id:'todo',icon:'tasks',en:'Plan',es:'Organízate',body:'Keep the small things together.',cuerpo:'Tus pendientes, en un solo lugar.'},
];
---
<div class="island-demo" data-mini-demo>
  <div class="journey" aria-label="Demo activities">
    {activities.map(a => <button type="button" class="activity" data-activity={a.id} aria-pressed={a.id==='music'}><Icon name={a.icon}/><span><strong><T en={a.en} es={a.es}/></strong><small><T en={a.body} es={a.cuerpo}/></small></span></button>)}
  </div>
  <div class="demo-stage">
    <div class="stage-controls"><span><T en="Try the island" es="Prueba la isla"/></span><button type="button" data-reset-demo><Icon name="reset"/><T en="Reset demo" es="Reiniciar demo"/></button></div>
    <div class="state-picker" role="group" aria-label="Island states" data-state-picker>
      <button type="button" data-island-state="idle" aria-pressed="false"><T en="Closed" es="Cerrada"/></button>
      <button type="button" data-island-state="activity" aria-pressed="false"><T en="Activity" es="Actividad"/></button>
      <button type="button" data-island-state="concurrent" aria-pressed="false"><T en="Activity + timer" es="Actividad + timer"/></button>
      <button type="button" data-island-state="expanded" aria-pressed="true"><T en="Expanded" es="Expandida"/></button>
      <button type="button" data-island-state="peek" aria-pressed="false"><T en="Compact open" es="Compacta abierta"/></button>
    </div>
    <div class="demo-options"><button type="button" data-alarm-sound aria-pressed="false"><T en="Alarm sound: off" es="Sonido de alarma: no"/></button><button type="button" data-test-alarm><Icon name="timer"/><T en="Try a 3-second timer" es="Probar timer de 3 segundos"/></button></div>
    <div class="island-viewport">
    <div class="island-shell" data-island-shell data-state="expanded">
      <svg class="island-surface" aria-hidden="true" data-island-surface><path data-island-path/></svg>
      <button type="button" class="compact-opener" data-island-toggle aria-label="Expand island" aria-expanded="true" aria-controls="mini-expanded" hidden>
        <span class="compact-content" aria-hidden="true"><span class="mini-art" data-compact-art><Icon name="music"/></span><span class="waveform" data-waveform>{[0,1,2,3,4,5].map(n=><i style={`--bar:${n}`}/>)}</span><span class="compact-timer-only" data-compact-timer-only hidden><Icon name="timer"/><span data-compact-time>25:00</span></span></span>
      </button>
      <button type="button" class="timer-bubble" data-timer-bubble aria-label="Open running timer" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="6" class="bubble-track"/><circle cx="12" cy="12" r="6" pathLength="100" class="bubble-progress" data-bubble-progress/><path d="M10 3h4m-2 0v3m0 3v3l2 1"/></svg></button>
    <div class="native-island" id="mini-expanded">
      <button type="button" class="close-island" data-island-close data-label-en="Collapse island" data-label-es="Contraer isla" aria-label="Collapse island"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3l7 7M4 10h6V4m11 17-7-7m6 0h-6v6"/></svg></button>
      <button type="button" class="open-wide" data-open-wide data-label-en="Open full island" data-label-es="Abrir isla completa" aria-label="Open full island" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 10 3 3m0 6V3h6m5 11 7 7m-6 0h6v-6"/></svg></button>
      <div class="native-tabs" role="tablist" aria-label="MiniTools demo">
        {activities.map(a => <button type="button" id={`mini-tab-${a.id}`} role="tab" aria-controls={`mini-panel-${a.id}`} aria-selected={a.id==='music'} tabindex={a.id==='music'?0:-1} data-mini-tab={a.id}><Icon name={a.icon}/><T en={a.id==='music'?'Music':a.id==='timers'?'Timers':'ToDo'} es={a.id==='music'?'Música':a.id==='timers'?'Temporizadores':'ToDo'}/></button>)}
      </div>
      <section id="mini-panel-music" role="tabpanel" aria-labelledby="mini-tab-music" class="music-panel" data-mini-panel="music">
        <div class="album-column"><div class="album" aria-hidden="true"><Icon name="music"/></div><small data-album-caption>Evening Walk</small></div>
        <div class="music-content"><p class="track-title" data-track-title>Evening Walk</p><p class="track-artist">Luis Gil</p>
          <label class="sr-only" for="mini-progress"><T en="Sample playback position" es="Posición de reproducción de ejemplo"/></label><div class="music-progress"><span data-elapsed>1:24</span><input id="mini-progress" type="range" min="0" max="212" value="84" data-progress/><span data-remaining>-2:08</span></div>
          <div class="player-row"><button type="button" class="favorite" data-favorite aria-pressed="false" data-label-en="Favorite sample track" data-label-es="Marcar pista de ejemplo como favorita" aria-label="Favorite sample track"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.8 5.7 6.3.9-4.5 4.4 1.1 6.2-5.7-3-5.7 3 1.1-6.2L3.2 9.6l6.3-.9Z"/></svg></button><div class="playback"><button type="button" data-track="previous" data-label-en="Previous sample track" data-label-es="Pista de ejemplo anterior" aria-label="Previous sample track"><svg viewBox="0 0 26 24" aria-hidden="true"><path d="M13 4 1 12l12 8V4Zm12 0-12 8 12 8V4Z"/></svg></button><button type="button" class="play-button" data-play aria-label="Play simulation"><span data-play-icon><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 2 22 12 5 22Z"/></svg></span></button><button type="button" data-track="next" data-label-en="Next sample track" data-label-es="Siguiente pista de ejemplo" aria-label="Next sample track"><svg viewBox="0 0 26 24" aria-hidden="true"><path d="M1 4 13 12 1 20V4Zm12 0 12 8-12 8V4Z"/></svg></button></div><div class="output-control"><button type="button" data-audio-output aria-expanded="false" aria-controls="mini-audio-output" data-label-en="Audio output information" data-label-es="Información de salida de audio" aria-label="Audio output information"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 15a7 7 0 1 1 10 0M4.5 18a10 10 0 1 1 15 0M12 15l5 6H7Z"/></svg></button><p id="mini-audio-output" hidden><T en="Music playback is simulated. Alarm tones are optional; real audio output controls are in the Mac app." es="La música es simulada. Los tonos de alarma son opcionales; los controles de salida reales están en la app para Mac."/></p></div></div>
        </div>
      </section>
      <section id="mini-panel-timers" role="tabpanel" aria-labelledby="mini-tab-timers" class="timers-panel" data-mini-panel="timers" hidden>
        <div class="timer-focus"><div class="timer-ring" data-timer-ring><svg viewBox="0 0 126 126" aria-hidden="true"><circle cx="63" cy="63" r="59" class="ring-track"/><circle cx="63" cy="63" r="59" pathLength="100" class="ring-progress" data-ring-progress/></svg><div class="ring-center"><Icon name="timer"/><output class="timer-digits" aria-live="off" data-timer>25:00</output></div></div><span class="timer-name"><T en="Focus time" es="Tiempo de enfoque"/></span><div class="timer-actions"><button type="button" data-timer-toggle aria-label="Start timer"><span data-timer-play-icon><Icon name="play"/></span></button><button type="button" data-timer-reset data-label-en="Reset timer" data-label-es="Reiniciar temporizador" aria-label="Reset timer"><Icon name="reset"/></button></div><div class="quick-timers">{[5,15,25].map(n=><button type="button" data-minutes={n}>{n} min</button>)}</div></div>
        <div class="timer-list"><h3><T en="Timers" es="Temporizadores"/></h3><div class="timer-row"><Icon name="timer"/><span><T en="Focus time" es="Tiempo de enfoque"/><small data-timer-state><T en="Ready when you are" es="Listo cuando tú quieras"/></small></span><span data-timer-secondary>25:00</span></div><p><T en="Choose a quick timer, then start. It keeps running while you explore the other tools." es="Elige un temporizador e inícialo. Sigue corriendo mientras pruebas las otras herramientas."/></p></div>
      </section>
      <section id="mini-panel-todo" role="tabpanel" aria-labelledby="mini-tab-todo" class="todo-panel" data-mini-panel="todo" hidden>
        <div class="todo-heading"><h3>ToDo</h3><span data-task-count></span><button type="button" data-clear-completed><T en="Clear completed" es="Limpiar completadas"/></button></div>
        <form data-task-form><label class="sr-only" for="mini-new-task"><T en="New sample task" es="Nueva tarea de ejemplo"/></label><input id="mini-new-task" type="text" maxlength="100" placeholder="New task" data-new-task/><button type="submit" class="native-primary" data-add-task><Icon name="plus"/><T en="Add" es="Agregar"/></button></form>
        <div class="tasks" data-task-list></div><p class="empty-tasks" data-task-empty hidden><T en="All clear. Add a task to try it out." es="Todo listo. Agrega una tarea para probar."/></p>
      </section>
    </div>
    <div class="hover-timer" data-hover-timer hidden><button type="button" class="peek-close" data-close-compact data-label-en="Close compact controls" data-label-es="Cerrar controles compactos" aria-label="Close compact controls"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button><div class="peek-actions"><button type="button" data-peek-timer-toggle aria-label="Pause timer"><span data-peek-timer-icon><Icon name="play"/></span></button><button type="button" data-peek-timer-cancel data-label-en="Cancel timer" data-label-es="Cancelar temporizador" aria-label="Cancel timer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div><div class="peek-timer-time"><span><T en="Focus time" es="Tiempo de enfoque"/></span><output data-peek-time>25:00</output></div><button type="button" class="open-wide" data-open-timer-wide data-label-en="Open full timer panel" data-label-es="Abrir panel completo del temporizador" aria-label="Open full timer panel"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 10 3 3m0 6V3h6m5 11 7 7m-6 0h6v-6"/></svg></button></div>
    <div class="timer-alert" data-timer-alert hidden><div><strong><T en="Focus time" es="Tiempo de enfoque"/></strong><span><T en="Time is up" es="Tiempo terminado"/></span></div><button type="button" data-alert-repeat data-label-en="Repeat timer" data-label-es="Repetir temporizador" aria-label="Repeat timer"><Icon name="reset"/></button><button type="button" data-alert-finish data-label-en="Finish timer" data-label-es="Finalizar temporizador" aria-label="Finish timer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
    </div></div>
    <p class="state-description" data-state-description><T en="The full island. Choose a tab, or collapse it to keep activity at a glance." es="La isla completa. Elige una pestaña o ciérrala para ver tu actividad de un vistazo."/></p>
    <div class="demo-status" role="status" aria-live="polite" data-demo-status></div>
    <p class="demo-disclosure"><T en="Interactive web simulation. No access to your Mac, music or tasks. Optional synthetic alarm tones stop after 10 seconds or when dismissed." es="Simulación web interactiva. Sin acceso a tu Mac, música ni tareas. Los tonos opcionales se detienen al cerrar la alerta o después de 10 segundos."/></p>
  </div>
</div>
<script>
  const demo = document.querySelector<HTMLElement>('[data-mini-demo]');
  if (demo) {
    const q = <T extends HTMLElement>(s: string) => demo.querySelector<T>(s)!;
    const text = (en: string, es: string) => document.documentElement.lang === 'es' ? es : en;
    const clock = (seconds: number) => `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2,'0')}`;
    const tracks = ['Evening Walk','Quiet Morning','Blue Hour'];
    let active = 'music', track = 0, playing = false, elapsed = 84, duration = 1500, remaining = 1500, running = false, deadline = 0, isExpanded = true;
    let compactView: 'music' | 'timers' | null = null, alerting = false, hoverPinned = false, hoverExit = 0, hoverEnter = 0, hoverArmed = true, soundEnabled = false;
    let hoverOrigin: {view:'music'|'timers';rect:DOMRect}|null=null;
    let audio: AudioContext | null = null, alarmLoop = 0, alarmLimit = 0;
    const sounding = new Set<OscillatorNode>();
    const favorites = new Set<number>();
    let tasks = [{id:1,en:'Review MiniTools with Luis',es:'Revisar MiniTools con Luis',done:false},{id:2,en:'Take a screen break',es:'Descansar de la pantalla',done:false},{id:3,en:'Plan tomorrow',es:'Planear mañana',done:true}];
    let taskId = 4;
    function announce(en: string, es: string) { q('[data-demo-status]').textContent = text(en,es); }
    function setExpanded(expanded: boolean) {
      if(alerting)return;window.clearTimeout(hoverExit);window.clearTimeout(hoverEnter);hoverOrigin=null;hoverArmed=expanded;compactView=null;hoverPinned=false;isExpanded=expanded;renderCompact();
    }
    function openCompact(view: 'music'|'timers', pinned=false){if(alerting||isExpanded)return;window.clearTimeout(hoverExit);window.clearTimeout(hoverEnter);if(pinned)hoverOrigin=null;compactView=view;hoverPinned=pinned;active=view;demo!.querySelectorAll<HTMLElement>('[data-mini-panel]').forEach(p=>p.hidden=p.dataset.miniPanel!==view);demo!.querySelectorAll<HTMLElement>('[data-activity]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.activity===view)));renderCompact();}
    function closeCompact(){if(alerting||isExpanded)return;window.clearTimeout(hoverEnter);hoverOrigin=null;hoverArmed=false;compactView=null;hoverPinned=false;renderCompact();}
    function stopAlarm(){window.clearInterval(alarmLoop);window.clearTimeout(alarmLimit);alarmLoop=0;alarmLimit=0;sounding.forEach(node=>{try{node.stop();}catch{}});sounding.clear();}
    function playAlarm(){
      stopAlarm();if(!soundEnabled||!audio||audio.state!=='running')return;
      const pulse=()=>{if(!audio||!soundEnabled||!alerting)return;const context=audio;[0,.22,.44].forEach(delay=>{const oscillator=context.createOscillator(),gain=context.createGain(),start=context.currentTime+delay;oscillator.type='sine';oscillator.frequency.value=880;gain.gain.setValueAtTime(0,start);gain.gain.linearRampToValueAtTime(.055,start+.015);gain.gain.exponentialRampToValueAtTime(.0001,start+.15);oscillator.connect(gain);gain.connect(context.destination);sounding.add(oscillator);oscillator.onended=()=>{sounding.delete(oscillator);oscillator.disconnect();gain.disconnect();};oscillator.start(start);oscillator.stop(start+.17);});};
      pulse();alarmLoop=window.setInterval(pulse,1500);alarmLimit=window.setTimeout(stopAlarm,10000);
    }
    function renderSound(){q('[data-alarm-sound]').setAttribute('aria-pressed',String(soundEnabled));q('[data-alarm-sound]').textContent=soundEnabled?text('Alarm sound: on','Sonido de alarma: sí'):text('Alarm sound: off','Sonido de alarma: no');}
    function finishAlert(repeat=false){stopAlarm();alerting=false;compactView=null;isExpanded=false;hoverPinned=false;remaining=repeat?duration:0;running=repeat;if(repeat)deadline=Date.now()+duration*1000;renderTimer();q('[data-island-toggle]').focus();announce(repeat?'Timer restarted':'Timer finished',repeat?'Temporizador reiniciado':'Temporizador finalizado');}
    function showTimerAlert(){const focusedInside=q('[data-island-shell]').contains(document.activeElement);window.clearTimeout(hoverExit);window.clearTimeout(hoverEnter);hoverOrigin=null;running=false;remaining=0;alerting=true;compactView=null;isExpanded=false;renderTimer();announce('Time is up. Repeat or finish the timer.','Tiempo terminado. Repite o finaliza el temporizador.');if(focusedInside)q('[data-alert-finish]').focus();playAlarm();}
    function select(id: string) {
      active = id; setExpanded(true);
      demo!.querySelectorAll<HTMLElement>('[data-mini-panel]').forEach(p => p.hidden = p.dataset.miniPanel !== id);
      demo!.querySelectorAll<HTMLElement>('[data-mini-tab]').forEach(b => {const selected=b.dataset.miniTab===id;b.setAttribute('aria-selected',String(selected));b.tabIndex=selected?0:-1;});
      demo!.querySelectorAll<HTMLElement>('[data-activity]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.activity===id))); renderCompact();
    }
    // Port of VirtualNotchShape: concave upper shoulders, rounded lower corners.
    function drawSurface(){
      const shell=q('[data-island-shell]'),w=shell.clientWidth,h=shell.clientHeight,split=shell.dataset.state==='concurrent';
      const open=isExpanded||compactView!==null||alerting,width=split?246:w,top=open?10:6,left=top,right=width-top,bottom=Math.min(open?24:13,h/2);
      q('[data-island-surface]').setAttribute('viewBox',`0 0 ${w} ${h}`);
      q('[data-island-path]').setAttribute('d',`M0 0H${width}C${width-top*.55} 0 ${right} ${top*.45} ${right} ${top}V${h-bottom}Q${right} ${h} ${right-bottom} ${h}H${left+bottom}Q${left} ${h} ${left} ${h-bottom}V${top}C${left} ${top*.45} ${top*.55} 0 0 0Z`);
    }
    function renderCompact() {
      const state=alerting?'alert':isExpanded?'expanded':compactView?`hover-${compactView}`:playing&&running?'concurrent':playing||running?'activity':'idle';
      const open=isExpanded||compactView!==null||alerting;
      q('[data-island-shell]').dataset.state=state;q('[data-island-shell]').dataset.playing=String(playing);
      q('#mini-expanded').hidden=alerting||(!isExpanded&&compactView!=='music');q('[data-hover-timer]').hidden=alerting||compactView!=='timers';q('[data-timer-alert]').hidden=!alerting;q('[data-island-toggle]').hidden=open;q('[data-island-toggle]').setAttribute('aria-expanded',String(open));q('[data-open-wide]').hidden=compactView!=='music';
      q('[data-compact-art]').hidden=!playing;q('[data-waveform]').hidden=!playing||running;q('[data-compact-timer-only]').hidden=playing||!running;
      q('[data-timer-bubble]').hidden=state!=='concurrent';q('[data-compact-time]').textContent=clock(remaining);
      q('[data-bubble-progress]').style.strokeDashoffset=String(100*(remaining/duration));
      q('[data-island-toggle]').setAttribute('aria-label',playing?text('Expand music island','Expandir isla de música'):running?text('Expand timer island','Expandir isla del temporizador'):text('Expand island','Expandir isla'));
      q('[data-timer-bubble]').setAttribute('aria-label',text('Open running timer: ','Abrir temporizador en curso: ')+clock(remaining));
      demo!.querySelectorAll<HTMLButtonElement>('[data-island-state]').forEach(b=>{b.setAttribute('aria-pressed',String(b.dataset.islandState===(compactView?'peek':state)));b.disabled=alerting;});
      demo!.querySelectorAll<HTMLButtonElement>('[data-activity]').forEach(b=>b.disabled=alerting);
      const descriptions:Record<string,string>={idle:text('Hover or tap the closed island to open its compact controls.','Pasa el cursor o toca la isla cerrada para abrir sus controles compactos.'),activity:playing?text('Music is playing in the simulation. Hover or tap for compact controls.','La música se está simulando. Pasa el cursor o toca para ver los controles compactos.'):text('A timer is running. Hover or tap to see its compact controls.','Hay un temporizador en curso. Pasa el cursor o toca para ver sus controles compactos.'),concurrent:text('Music and a timer, together. Hover or tap either area to open its compact controls.','Música y temporizador, juntos. Pasa el cursor o toca cada zona para abrir sus controles compactos.'),expanded:text('The full island. Choose a tab, or collapse it to keep activity at a glance.','La isla completa. Elige una pestaña o ciérrala para ver tu actividad de un vistazo.'),'hover-music':text('Compact music controls. Use the expand button for the full island.','Controles compactos de música. Usa el botón de ampliar para abrir la isla completa.'),'hover-timers':text('Compact timer controls. Pause, cancel or open the full timer panel.','Controles compactos del temporizador. Pausa, cancela o abre el panel completo.'),alert:text('Time is up. The alert stays open until you repeat or finish it.','Tiempo terminado. La alerta permanece abierta hasta que repitas o finalices el temporizador.')};
      q('[data-state-description]').textContent=descriptions[state];drawSurface();
    }
    function renderMusic() {
      q('[data-track-title]').textContent=tracks[track];q('[data-album-caption]').textContent=tracks[track];q('[data-elapsed]').textContent=clock(elapsed);q('[data-remaining]').textContent='-'+clock(212-elapsed);q<HTMLInputElement>('[data-progress]').value=String(elapsed);q('[data-favorite]').setAttribute('aria-pressed',String(favorites.has(track)));
      q('[data-play]').setAttribute('aria-label',playing?text('Pause simulation','Pausar simulación'):text('Play simulation','Reproducir simulación'));
      q('[data-play]').setAttribute('aria-pressed',String(playing));q('[data-play-icon]').classList.toggle('is-playing',playing);renderCompact();
    }
    function renderTimer() {q('[data-timer]').textContent=clock(remaining);q('[data-timer-secondary]').textContent=clock(remaining);q('[data-peek-time]').textContent=clock(remaining);const label=running?text('Pause timer','Pausar temporizador'):remaining===0?text('Restart timer','Reiniciar temporizador'):text('Start timer','Iniciar temporizador');q('[data-timer-toggle]').setAttribute('aria-label',label);q('[data-peek-timer-toggle]').setAttribute('aria-label',label);q('[data-peek-timer-icon]').classList.toggle('is-playing',running);q('[data-timer-play-icon]').classList.toggle('is-playing',running);q('[data-ring-progress]').style.strokeDashoffset=String(100*(remaining/duration));q('[data-timer-ring]').classList.toggle('finished',remaining===0);q('[data-timer-state]').textContent=running?text('Running','En curso'):remaining===0?text('Finished','Terminado'):text('Ready when you are','Listo cuando tú quieras');renderCompact();}
    function renderTasks(focusId?: number, focusAction = 'check') {
      const list=q('[data-task-list]');list.replaceChildren();
      tasks.forEach((task,index)=>{
        const row=document.createElement('div');row.className='task-row';
        const label=document.createElement('label'),check=document.createElement('input');check.type='checkbox';check.checked=task.done;check.dataset.taskId=String(task.id);check.dataset.taskAction='check';
        check.addEventListener('change',()=>{task.done=check.checked;renderTasks(task.id);});
        const title=document.createElement('span');title.textContent=text(task.en,task.es);label.append(check,title);
        const remove=document.createElement('button');remove.type='button';remove.className='task-remove';remove.dataset.taskId=String(task.id);remove.dataset.taskAction='delete';remove.setAttribute('aria-label',text('Delete task: ','Eliminar tarea: ')+title.textContent);
        const svg=document.createElementNS('http://www.w3.org/2000/svg','svg'),path=document.createElementNS('http://www.w3.org/2000/svg','path');svg.setAttribute('viewBox','0 0 24 24');svg.setAttribute('aria-hidden','true');svg.setAttribute('width','16');svg.setAttribute('height','16');svg.setAttribute('fill','none');svg.setAttribute('stroke','currentColor');svg.setAttribute('stroke-width','1.7');svg.setAttribute('stroke-linecap','round');svg.setAttribute('stroke-linejoin','round');path.setAttribute('d','M3 6h18M9 6V3h6v3M6 6l1 15h10l1-15M10 10v7m4-7v7');svg.append(path);remove.append(svg);
        remove.addEventListener('click',()=>{const neighbor=tasks[index+1]?.id??tasks[index-1]?.id;tasks=tasks.filter(t=>t.id!==task.id);renderTasks(neighbor,'delete');if(neighbor===undefined)q<HTMLInputElement>('[data-new-task]').focus();announce('Task deleted','Tarea eliminada');});
        row.append(label,remove);list.append(row);
      });
      q('[data-task-count]').textContent=`${tasks.filter(t=>!t.done).length} ${text('pending','pendientes')}`;q('[data-task-empty]').hidden=tasks.length>0;q<HTMLButtonElement>('[data-clear-completed]').disabled=!tasks.some(t=>t.done);
      if(focusId!==undefined)list.querySelector<HTMLElement>(`[data-task-id="${focusId}"][data-task-action="${focusAction}"]`)?.focus();
    }
    demo.querySelectorAll<HTMLElement>('[data-activity],[data-mini-tab]').forEach(b=>b.addEventListener('click',()=>select(b.dataset.activity||b.dataset.miniTab!)));
    const tabs=Array.from(demo.querySelectorAll<HTMLElement>('[data-mini-tab]'));
    tabs.forEach((tab,i)=>tab.addEventListener('keydown',e=>{let next=i;if(e.key==='ArrowRight')next=(i+1)%tabs.length;else if(e.key==='ArrowLeft')next=(i+tabs.length-1)%tabs.length;else if(e.key==='Home')next=0;else if(e.key==='End')next=tabs.length-1;else return;e.preventDefault();tabs[next].focus();select(tabs[next].dataset.miniTab!);}));
    q('[data-island-toggle]').addEventListener('click',()=>{openCompact(playing?'music':running?'timers':'music',true);q(compactView==='timers'?'[data-peek-timer-toggle]':'[data-play]').focus();});
    q('[data-island-close]').addEventListener('click',()=>{setExpanded(false);q('[data-island-toggle]').focus();});
    q('[data-timer-bubble]').addEventListener('click',()=>{openCompact('timers',true);q('[data-peek-timer-toggle]').focus();});
    q('[data-open-wide]').addEventListener('click',()=>{select('music');q('[data-mini-tab="music"]').focus();});
    q('[data-open-timer-wide]').addEventListener('click',()=>{select('timers');q('[data-mini-tab="timers"]').focus();});
    q('[data-close-compact]').addEventListener('click',()=>{closeCompact();q('[data-island-toggle]').focus();});
    q('[data-island-shell]').addEventListener('keydown',e=>{if(e.key==='Escape'&&!alerting){setExpanded(false);q('[data-island-toggle]').focus();}});
    const canHover=(e:PointerEvent)=>e.pointerType==='mouse'&&window.matchMedia('(hover: hover)').matches;
    // Wait for deliberate hover, so crossing the music hit area cannot steal a timer click.
    function queueHover(event:PointerEvent,view:'music'|'timers'){
