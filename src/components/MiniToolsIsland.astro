    q('[data-alarm-sound]').addEventListener('click',async()=>{
      if(soundEnabled){soundEnabled=false;stopAlarm();renderSound();return;}
      const button=q<HTMLButtonElement>('[data-alarm-sound]');button.disabled=true;
      try{audio??=new AudioContext();await audio.resume();soundEnabled=audio.state==='running';renderSound();announce(soundEnabled?'Optional alarm tone enabled. Use the three-second timer to try it.':'Audio is blocked by this browser. The visual alert still works.',soundEnabled?'Tono opcional activado. Usa el temporizador de tres segundos para probarlo.':'El navegador bloqueó el audio. La alerta visual sigue funcionando.');if(soundEnabled&&alerting)playAlarm();}
