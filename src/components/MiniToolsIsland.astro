    });
    q('[data-timer-reset]').addEventListener('click',()=>{running=false;remaining=duration;renderTimer();});
    demo.querySelectorAll<HTMLElement>('[data-minutes]').forEach(b=>b.addEventListener('click',()=>{duration=Number(b.dataset.minutes)*60;remaining=duration;running=false;renderTimer();}));
    q('[data-task-form]').addEventListener('submit',e=>{e.preventDefault();const input=q<HTMLInputElement>('[data-new-task]'),value=input.value.trim();if(!value)return;tasks.push({id:taskId++,en:value,es:value,done:false});input.value='';renderTasks();input.focus();announce('Task added','Tarea agregada');});
    q('[data-clear-completed]').addEventListener('click',()=>{tasks=tasks.filter(t=>!t.done);renderTasks();announce('Completed tasks cleared','Tareas completadas eliminadas');});
    q('[data-reset-demo]').addEventListener('click',()=>{stopAlarm();alerting=false;compactView=null;soundEnabled=false;renderSound();track=0;playing=false;elapsed=84;duration=1500;remaining=1500;running=false;favorites.clear();q('[data-audio-output]').setAttribute('aria-expanded','false');q('#mini-audio-output').hidden=true;tasks=[{id:1,en:'Review MiniTools with Luis',es:'Revisar MiniTools con Luis',done:false},{id:2,en:'Take a screen break',es:'Descansar de la pantalla',done:false},{id:3,en:'Plan tomorrow',es:'Planear mañana',done:true}];taskId=4;q<HTMLInputElement>('[data-new-task]').value='';select('music');renderMusic();renderTimer();renderTasks();announce('Demo reset','Demo reiniciada');});
    function localize(){demo!.querySelectorAll<HTMLElement>('[data-label-en]').forEach(e=>e.setAttribute('aria-label',text(e.dataset.labelEn!,e.dataset.labelEs!)));q('[data-state-picker]').setAttribute('aria-label',text('Island states','Estados de la isla'));q<HTMLInputElement>('[data-new-task]').placeholder=text('New task','Nueva tarea');renderMusic();renderTimer();renderTasks();renderSound();renderCompact();q('[data-demo-status]').textContent='';}
