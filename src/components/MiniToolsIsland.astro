      if(!canHover(event)||!hoverArmed||isExpanded||alerting||shell.contains(document.activeElement))return;
      hoverEnter=window.setTimeout(()=>{if(hoverArmed&&target.matches(':hover')&&!shell.contains(document.activeElement)){hoverOrigin={view,rect:target.getBoundingClientRect()};openCompact(view);}},120);
    }
    q('[data-island-toggle]').addEventListener('pointerenter',e=>queueHover(e,playing?'music':running?'timers':'music'));
    q('[data-timer-bubble]').addEventListener('pointerenter',e=>queueHover(e,'timers'));
    ['[data-island-toggle]','[data-timer-bubble]'].forEach(selector=>q(selector).addEventListener('pointerleave',()=>window.clearTimeout(hoverEnter)));
    // Like the native wide-mode exit, minimizing stays closed until the pointer moves away.
    const insideOrigin=(x:number,y:number)=>hoverOrigin!==null&&x>=hoverOrigin.rect.left&&x<=hoverOrigin.rect.right&&y>=hoverOrigin.rect.top&&y<=hoverOrigin.rect.bottom;
    const rearmHover=(e:PointerEvent)=>{if(hoverOrigin&&!insideOrigin(e.clientX,e.clientY))hoverOrigin=null;if(!hoverArmed&&e.pointerType==='mouse'&&!q('[data-island-shell]').contains(e.target as Node))hoverArmed=true;};
    document.addEventListener('pointermove',rearmHover);
    q('[data-island-shell]').addEventListener('pointerdown',()=>window.clearTimeout(hoverEnter),true);
    // Newly revealed controls must not consume the gesture aimed at the old trigger.
    q('[data-island-shell]').addEventListener('click',e=>{if(e.detail===0||!hoverOrigin||!insideOrigin(e.clientX,e.clientY))return;const view=hoverOrigin.view;e.preventDefault();e.stopImmediatePropagation();openCompact(view,true);q(view==='timers'?'[data-peek-timer-toggle]':'[data-play]').focus();},true);
    q('[data-island-shell]').addEventListener('pointerenter',()=>window.clearTimeout(hoverExit));
    q('[data-island-shell]').addEventListener('pointerleave',()=>{window.clearTimeout(hoverExit);hoverExit=window.setTimeout(()=>{if(!hoverPinned&&!q('[data-island-shell]').contains(document.activeElement))closeCompact();},220);});
    q('[data-island-shell]').addEventListener('focusout',()=>{hoverExit=window.setTimeout(()=>{if(!hoverPinned&&!q('[data-island-shell]').matches(':hover')&&!q('[data-island-shell]').contains(document.activeElement))closeCompact();},220);});
    demo.querySelectorAll<HTMLElement>('[data-island-state]').forEach(button=>button.addEventListener('click',()=>{
      const state=button.dataset.islandState!;
      hoverOrigin=null;
      if(state==='peek'){isExpanded=false;openCompact(playing?'music':running?'timers':'music',true);return;}
      if(state==='idle'){playing=false;running=false;}
      if(state==='activity'){playing=true;running=false;}
      if(state==='concurrent'){playing=true;if(!running){if(!remaining)remaining=duration;running=true;deadline=Date.now()+remaining*1000;}}
