---
import T from './ProposalText.astro';
---
<section class="support-maker" aria-labelledby="support-maker-title">
  <div><h2 id="support-maker-title"><T en="Support my work" es="Apoya mi trabajo"/></h2><T as="p" en="Enjoy what I'm building? A coffee helps me keep making independent software." es="¿Te gusta lo que estoy creando? Un café me ayuda a seguir desarrollando software independiente."/></div>
  <div class="support-actions"><a href="https://buymeacoffee.com/luisgil" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h12v7a5 5 0 0 1-5 5h-2a5 5 0 0 1-5-5V8Zm12 1h2a3 3 0 0 1 0 6h-2M8 3v2m4-2v2M3 22h17"/></svg>Buy Me a Coffee</a><a href="https://ko-fi.com/luisgildev" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h13v10a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4V6Zm13 2h2a3 3 0 0 1 0 6h-2M7 11c0-2 3-2 3 0 0-2 3-2 3 0 0 2-3 4-3 4s-3-2-3-4Z"/></svg>Ko-fi</a></div>
</section>
<style>
  .support-maker{display:flex;align-items:center;justify-content:space-between;gap:32px;padding:36px 0;border-top:1px solid var(--line);margin:55px auto 0;max-width:1100px}.support-maker h2{font-size:23px;letter-spacing:-.025em}.support-maker p{font-size:14px;line-height:1.7;color:var(--muted);max-width:48ch;margin-top:10px}.support-actions{display:flex;flex-wrap:wrap;gap:12px;flex-shrink:0}.support-actions a{display:flex;align-items:center;gap:9px;border:1px solid var(--line);border-radius:9px;padding:12px 15px;font-size:13px;font-weight:600;text-decoration:none;background:var(--surface);color:var(--ink)}.support-actions a:hover{border-color:var(--accent);color:var(--accent)}svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}@media(max-width:1000px){.support-maker{align-items:flex-start;flex-direction:column;gap:22px}}@media(max-width:500px){.support-actions{gap:9px}.support-actions a{font-size:12px;padding:11px}}
</style>
