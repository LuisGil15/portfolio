---
import T from './ProposalText.astro';
import ThemeToggle from './ThemeToggle.astro';
import SupportLinks from './SupportLinks.astro';
import Icon from './MiniToolsIcon.astro';
import Mark from './MiniToolsMark.astro';
import Notch from './MiniToolsNotch.astro';
import Island from './MiniToolsIsland.astro';
import PluginDemo from './MiniToolsPluginDemo.astro';
const release = 'https://github.com/LuisGil15/MiniTools/releases/latest';
const download = 'https://github.com/LuisGil15/MiniTools/releases/download/v1.0.8/MiniTools-1.0.8.dmg';
const pluginCatalog = 'https://github.com/LuisGil15/MiniTools-Plugins';
const features = [
 {icon:'music',en:'Music, without the detour.',es:'Tu música, sin rodeos.',body:'Artwork and playback controls, right in the island. Keep the soundtrack close while you work.',cuerpo:'Carátulas y controles de reproducción en la isla. Tu música a mano mientras trabajas.'},
 {icon:'timer',en:'A little time for yourself.',es:'Un poco de tiempo para ti.',body:'Quick timers and custom durations. Your timers persist, with alerts in the island and notifications.',cuerpo:'Temporizadores rápidos y duraciones personalizadas. Se conservan, con alertas en la isla y notificaciones.'},
 {icon:'calendar',en:'The day, together.',es:'Tu día, reunido.',body:'See your calendar, create events and check macOS Reminders without opening another window.',cuerpo:'Consulta tu calendario, crea eventos y revisa Recordatorios de macOS sin abrir otra ventana.'},
 {icon:'weather',en:'The small things count.',es:'Los pequeños detalles cuentan.',body:'Local weather and a persistent ToDo list keep everyday details within reach.',cuerpo:'El clima local y una lista ToDo persistente mantienen tus pendientes al alcance.'},
];
const plugins = [
 {name:'Launchpad',icon:'grid',categoryEn:'Productivity',categoryEs:'Productividad',en:'A drag-and-drop grid for your favorite apps.',es:'Una cuadrícula para tus apps favoritas, organizada con drag and drop.',download:'https://raw.githubusercontent.com/LuisGil15/MiniTools-Plugins/main/packages/Launchpad-0.1.0.minitoolplugin'},
 {name:'Caffeine',icon:'coffee',categoryEn:'Utilities',categoryEs:'Utilidades',en:'Timed or indefinite keep-awake sessions.',es:'Sesiones temporizadas o indefinidas para mantener tu Mac despierta.',download:'https://raw.githubusercontent.com/LuisGil15/MiniTools-Plugins/main/packages/Caffeine-0.1.0.minitoolplugin'},
 {name:'Ports',icon:'network',categoryEn:'Developer tools',categoryEs:'Desarrollo',en:'Inspect local listeners and explicitly stop a process.',es:'Inspecciona puertos locales y detén un proceso de forma explícita.',download:'https://raw.githubusercontent.com/LuisGil15/MiniTools-Plugins/main/packages/Ports-0.1.0.minitoolplugin'},
 {name:'Screenshot Board',icon:'captures',categoryEn:'Productivity',categoryEs:'Productividad',en:'Collect recent captures and drag them into other apps.',es:'Reúne capturas recientes y arrástralas a otras apps.',download:'https://raw.githubusercontent.com/LuisGil15/MiniTools-Plugins/main/packages/ScreenshotBoard-0.1.0.minitoolplugin'},
 {name:'Mini Terminal',icon:'terminal',categoryEn:'Developer tools',categoryEs:'Desarrollo',en:'A real interactive login shell inside the island.',es:'Una sesión de shell real e interactiva dentro de la isla.',download:'https://raw.githubusercontent.com/LuisGil15/MiniTools-Plugins/main/packages/MiniTerminal-0.1.0.minitoolplugin'},
 {name:'Agent Pulse',icon:'pulse',categoryEn:'Developer tools',categoryEs:'Desarrollo',en:'Codex activity, help requests and completion alerts.',es:'Actividad de Codex, solicitudes de ayuda y alertas al terminar.',download:'https://raw.githubusercontent.com/LuisGil15/MiniTools-Plugins/main/packages/AgentPulse-0.1.0.minitoolplugin'},
];
---
<header class="mini-header"><a class="brand" href="/apps/minitools/" aria-label="MiniTools home"><Mark size={38}/><span>MiniTools</span></a><nav aria-label="MiniTools"><a href="#features"><T en="Features" es="Funciones"/></a><a href="#plugins">Plugins</a><a href="#install"><T en="Install" es="Instalar"/></a></nav><div class="header-actions"><ThemeToggle/><button class="language" type="button" data-language>ES</button><a class="button header-download" href={download}><Icon name="download"/><T en="Download for Mac" es="Descargar para Mac"/></a></div></header>
<main id="content">
  <section class="opening" aria-labelledby="mini-title">
    <div class="intro"><h1 id="mini-title"><T en="Small tools.&#10;Right where you need them." es="Pequeñas herramientas.&#10;Justo donde las necesitas."/></h1><T as="p" en="Music, timers, calendar, reminders, weather and local tasks. A little more room for your day." es="Música, temporizadores, calendario, recordatorios, clima y tareas locales. Un poco más de espacio para tu día."/><div class="intro-actions"><a class="button" href={download}><Icon name="download"/><T en="Download for Mac" es="Descargar para Mac"/></a><span>macOS 13+ <span aria-hidden="true">·</span> Apple silicon</span></div><p class="notch-line"><Icon name="check"/><T en="With or without a notch." es="Con o sin notch."/></p></div>
    <Island/>
  </section>
  <section class="features section-wrap" id="features" aria-labelledby="features-heading"><div class="section-heading"><h2 id="features-heading"><T en="One island.&#10;Room for your day." es="Una isla.&#10;Espacio para tu día."/></h2><T as="p" en="The tools you reach for, brought together at the top of your screen. Expand when you need them. Stay compact when you don't." es="Las herramientas que usas, reunidas en la parte superior de tu pantalla. Expándelas cuando las necesites. Mantén la isla compacta cuando no."/></div><div class="feature-list">{features.map(f=><article><Icon name={f.icon}/><div><h3><T en={f.en} es={f.es}/></h3><T as="p" en={f.body} es={f.cuerpo}/></div></article>)}</div></section>
  <section class="compatibility" aria-labelledby="compatibility-title"><div class="section-wrap compatibility-inner"><Notch/><div class="compatibility-copy"><h2 id="compatibility-title"><T en="Your notch, with more to do.&#10;Or a new one." es="Tu notch, con más que hacer.&#10;O uno nuevo."/></h2><T as="p" en="On a MacBook with a notch, MiniTools adds interactive controls around it. On screens without one, it creates a virtual notch. Same tools, on your preferred display." es="En una MacBook con notch, MiniTools agrega controles interactivos a su alrededor. En pantallas sin notch, crea uno virtual. Las mismas herramientas, en tu pantalla preferida."/><p class="requirement"><T en="Requires macOS Ventura 13 or later and Apple silicon. Intel Macs are not supported." es="Requiere macOS Ventura 13 o posterior y Apple silicon. No es compatible con Macs Intel."/></p></div></div></section>
  <section class="plugins section-wrap" id="plugins" aria-labelledby="plugins-title"><div class="section-heading"><h2 id="plugins-title"><T en="Make it yours.&#10;One plugin at a time." es="Hazla tuya.&#10;Un plugin a la vez."/></h2><div><T as="p" en="Six official extensions are available now. Install only the tools you want from MiniTools, or download their packages directly." es="Ya hay seis extensiones oficiales disponibles. Instala sólo las herramientas que quieras desde MiniTools o descarga sus paquetes directamente."/><p class="catalog-note"><T en="For now, MiniTools only installs first-party plugins. I'm working toward opening the store so developers can collaborate or create plugins for their own workflows; third-party plugin support remains in Developer Preview." es="Por ahora, MiniTools sólo permite instalar plugins first-party. Estoy trabajando para abrir la tienda y que otras personas puedan colaborar o crear plugins para sus propias necesidades; el soporte para plugins de terceros sigue en Developer Preview."/></p><a class="catalog-link" href={pluginCatalog}><T en="Browse the complete catalog" es="Explorar el catálogo completo"/><Icon name="chevron"/></a></div></div><div class="plugin-catalog">{plugins.map(p=><article class="plugin"><div class="plugin-icon"><Icon name={p.icon}/></div><div><T as="p" class="plugin-category" en={p.categoryEn} es={p.categoryEs}/><h3>{p.name}</h3><T as="p" en={p.en} es={p.es}/></div><div class="plugin-meta"><span><T en="Available" es="Disponible"/> · v0.1.0</span><a href={p.download}><Icon name="download"/><T en="Download" es="Descargar"/></a></div></article>)}</div></section>
  <PluginDemo/>
  <section class="install section-wrap" id="install" aria-labelledby="install-title"><div><h2 id="install-title"><T en="A small download.&#10;A new place for your tools." es="Una pequeña descarga.&#10;Un nuevo lugar para tus herramientas."/></h2><T as="p" en="Download the disk image, open it and drag MiniTools into Applications. Then launch the app to meet your island." es="Descarga la imagen de disco, ábrela y arrastra MiniTools a Aplicaciones. Después abre la app para conocer tu isla."/><a class="button" href={download}><Icon name="download"/><T en="Download MiniTools 1.0.8" es="Descargar MiniTools 1.0.8"/></a><a class="release-link" href={release}><T en="Release notes and other downloads" es="Notas de versión y otras descargas"/></a><p class="install-requirement">macOS 13+ · Apple silicon</p></div><div class="brew"><h3><T en="Prefer Homebrew?" es="¿Prefieres Homebrew?"/></h3><T as="p" en="Install directly from the official tap." es="Instala directamente desde el tap oficial."/><div class="command"><code id="brew-command">brew install --cask LuisGil15/minitools/minitools</code><button type="button" data-copy-command><T en="Copy" es="Copiar"/></button></div><p class="copy-status" role="status" data-copy-status></p><T as="p" en="To update later:" es="Para actualizar después:"/><code class="update-command">brew update<br/>brew upgrade --cask minitools</code></div></section>
  <section class="faq section-wrap" aria-labelledby="faq-title"><h2 id="faq-title"><T en="A few things to know." es="Algunas cosas que debes saber."/></h2><div><details><summary><T en="Does my Mac need a notch?" es="¿Mi Mac necesita notch?"/><Icon name="chevron"/></summary><T as="p" en="No. MiniTools works with and without a notch, including on external displays. It requires Apple silicon and macOS 13 or later." es="No. MiniTools funciona con y sin notch, también en pantallas externas. Requiere Apple silicon y macOS 13 o posterior."/></details><details><summary><T en="How do I install plugins?" es="¿Cómo instalo plugins?"/><Icon name="chevron"/></summary><T as="p" en="Open MiniTools → Settings → Extension Store, choose an official extension and select Install. Its tab appears immediately; no restart is required. You can also install a downloaded .minitoolplugin package from Installed Plugins." es="Abre MiniTools → Ajustes → Extension Store, elige una extensión oficial y selecciona Instalar. Su pestaña aparece de inmediato, sin reiniciar la app. También puedes instalar un paquete .minitoolplugin descargado desde Plugins instalados."/></details><details><summary><T en="Is this demo the actual app?" es="¿Esta demo es la app real?"/><Icon name="chevron"/></summary><T as="p" en="No. This is an interactive web simulation with sample data. It does not play music or read your calendar, reminders or Mac. You can enable a sample alarm tone to try timer alerts. Download MiniTools for the native experience." es="No. Es una simulación web interactiva con datos de ejemplo. No reproduce música ni lee tu calendario, recordatorios o Mac. Puedes activar un tono de ejemplo para probar las alertas del temporizador. Descarga MiniTools para usar la experiencia nativa."/></details><details><summary><T en="How do I open and configure the island?" es="¿Cómo abro y configuro la isla?"/><Icon name="chevron"/></summary><T as="p" en="Move the pointer over the island to open its compact controls, then expand it to see every tab. Timer alerts also open the compact view. In the Mac app, right-click to open Settings, choose your display and configure your tools." es="Pasa el puntero sobre la isla para abrir sus controles compactos y expándela para ver todas las pestañas. Las alertas del temporizador también abren la vista compacta. En la app para Mac, haz clic derecho para abrir Ajustes, elegir la pantalla y configurar tus herramientas."/></details><details><summary><T en="Where can I get help?" es="¿Dónde puedo pedir ayuda?"/><Icon name="chevron"/></summary><p><T en="Report a problem or request a feature on " es="Reporta un problema o solicita una función en "/><a href="https://github.com/LuisGil15/MiniTools/issues">GitHub</a><T en=". Include your macOS version and what happened." es=". Incluye tu versión de macOS y lo que sucedió."/></p></details></div></section>
  <div class="section-wrap"><SupportLinks/></div>
</main>
<footer class="mini-footer section-wrap"><a class="brand" href="/apps/minitools/"><Mark size={28}/>MiniTools</a><p><T en="Made by " es="Creado por "/><a href="/">Luis Gil</a></p><a href="https://github.com/LuisGil15/MiniTools"><T en="GitHub & support" es="GitHub y soporte"/></a></footer>
<script>
  document.querySelector('[data-copy-command]')?.addEventListener('click',async()=>{const es=document.documentElement.lang==='es',status=document.querySelector('[data-copy-status]')!;try{await navigator.clipboard.writeText('brew install --cask LuisGil15/minitools/minitools');status.textContent=es?'Comando copiado.':'Command copied.';}catch{status.textContent=es?'No se pudo copiar. Selecciona y copia el comando de arriba.':'Could not copy. Select and copy the command above.';}});
  document.addEventListener('proposal-language',()=>{const status=document.querySelector('[data-copy-status]');if(status)status.textContent='';});
</script>
<style>
 .mini-header{display:flex;align-items:center;justify-content:space-between;gap:24px;max-width:1440px;margin:auto;padding:18px 40px}.brand{display:flex;align-items:center;gap:10px;font-size:21px;font-weight:700;text-decoration:none;letter-spacing:-.025em;white-space:nowrap}.brand img{border-radius:10px}.mini-header nav{display:flex;gap:28px;margin-left:auto}.mini-header nav a{text-decoration:none;font-size:14px;color:var(--muted)}.mini-header nav a:hover{color:var(--accent)}.header-actions{display:flex;align-items:center;gap:10px}.language{width:38px;height:38px;display:grid;place-items:center;background:var(--soft);border:1px solid var(--line);border-radius:8px;color:var(--ink);font-size:12px;padding:0}.button{display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:13px 20px;border-radius:8px;background:var(--button);color:white;text-decoration:none;font-weight:650;font-size:15px;min-height:46px}.button:hover{background:var(--button-hover)}.button svg{width:18px;height:18px}.header-download{font-size:12px;padding:10px 14px;min-height:38px}.opening{background:#102b51;color:#f3f7ff;padding:46px 40px 38px}.intro{text-align:center;max-width:880px;margin:0 auto 30px}.intro h1{font-size:clamp(36px,4.2vw,58px);line-height:1.04;font-weight:650;white-space:pre-line;letter-spacing:-.035em}.intro>p{color:#ccdbf0;max-width:61ch;font-size:17px;line-height:1.5;margin:18px auto 0}.intro-actions{display:flex;justify-content:center;align-items:center;gap:18px;margin-top:21px}.intro-actions>span{font-size:12px;color:#ccdbf0}.intro .notch-line{display:flex;align-items:center;justify-content:center;gap:5px;font-size:13px;margin:12px auto 0;color:#e8f2ff}.notch-line svg{width:16px;height:16px}.opening .button{background:#276ce0}.opening .button:hover{background:#1c5dcc}.section-wrap{max-width:1240px;padding-left:40px;padding-right:40px;margin-left:auto;margin-right:auto}.section-heading{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center}.section-heading h2,.compatibility h2,.install h2{font-size:clamp(30px,3.1vw,43px);line-height:1.09;font-weight:600;white-space:pre-line}.section-heading p,.compatibility-copy>p,.install>div>p{font-size:16px;line-height:1.7;color:var(--muted);max-width:60ch}.features{padding-top:87px;padding-bottom:82px}.feature-list{display:grid;grid-template-columns:1fr 1fr;column-gap:80px;row-gap:35px;margin-top:48px}.feature-list article{display:flex;gap:17px}.feature-list article>svg{width:24px;height:24px;color:var(--accent);margin-top:3px}.feature-list h3{font-size:20px;font-weight:600;letter-spacing:-.02em}.feature-list p{font-size:15px;line-height:1.7;color:var(--muted);margin-top:11px;max-width:47ch}.compatibility{background:var(--soft);padding:72px 0}.compatibility-inner{display:grid;grid-template-columns:1.08fr 1fr;gap:75px;align-items:center}.compatibility-copy>p{margin-top:20px}.compatibility-copy .requirement{font-size:13px;max-width:47ch}.display-pair{display:flex;gap:22px;align-items:center}.display{flex:1;text-align:center;min-width:0}.display-screen{background:#254d7f;aspect-ratio:1.52;border:6px solid #080d14;border-radius:9px;position:relative;padding-top:20px;display:flex;align-items:flex-start;justify-content:center}.mini-notch{position:absolute;top:0;left:36%;width:28%;height:14px;background:#080d14;border-radius:0 0 5px 5px}.tiny-island{color:#eef3fb;background:#080d14;display:flex;align-items:center;justify-content:center;gap:6px;width:88%;padding:8px 6px;border-radius:12px;font-size:8px;white-space:nowrap}.tiny-island svg{width:10px;height:10px}.display-stand{width:25%;height:17px;background:#263242;border-bottom:4px solid #435066;margin:auto}.display>span{display:block;font-size:12px;margin-top:15px;color:var(--muted)}.plugins{padding-top:86px;padding-bottom:83px}.section-heading .catalog-note{font-size:13px;margin-top:12px}.catalog-link{display:inline-flex;align-items:center;gap:7px;margin-top:17px;color:var(--accent);font-size:13px;font-weight:600;text-underline-offset:4px}.catalog-link svg{width:14px;height:14px;transform:rotate(-90deg)}.plugin-catalog{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:38px}.plugin{padding:24px;display:grid;grid-template-columns:43px 1fr;column-gap:14px;align-items:start;background:var(--surface);border:1px solid var(--line);border-radius:14px}.plugin-icon{display:grid;place-items:center;width:43px;height:43px;color:var(--accent);background:var(--tint);border-radius:11px}.plugin .plugin-category{font-size:10px;line-height:1.4;color:var(--accent);margin:0 0 3px;font-weight:650}.plugin h3{font-size:17px;letter-spacing:-.02em;margin-top:1px}.plugin p{font-size:13px;color:var(--muted);line-height:1.5;margin-top:7px}.plugin-meta{grid-column:2;display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:16px;font-size:11px}.plugin-meta>span{color:var(--accent);font-weight:600}.plugin-meta>a{display:inline-flex;align-items:center;gap:5px;color:var(--ink);text-underline-offset:4px}.plugin-meta svg{width:13px;height:13px}.install{display:grid;grid-template-columns:1fr 1fr;gap:85px;padding-top:65px;padding-bottom:70px;border-top:1px solid var(--line)}.install>div>p{margin-top:23px}.install .button{margin-top:24px}.release-link{display:block;color:var(--accent);font-size:13px;margin-top:15px}.install>div>.install-requirement{font-size:12px;margin-top:12px}.brew{align-self:center}.brew h3{font-size:23px;letter-spacing:-.02em}.brew>p{font-size:14px!important;margin-top:12px!important}.command{display:flex;flex-direction:column;align-items:flex-start;gap:17px;background:var(--soft);padding:22px;border-radius:12px;margin-top:20px}.command code,.update-command{font-size:12px;line-height:1.8;overflow-wrap:anywhere}.command button{border:1px solid var(--line);border-radius:6px;background:var(--surface);color:var(--ink);padding:7px 16px;font-size:12px}.command button:hover{border-color:var(--accent)}.brew .copy-status{min-height:20px;font-size:12px!important;color:var(--accent);margin-top:4px!important}.update-command{display:block;margin-top:10px;color:var(--muted)}.faq{padding-top:50px;padding-bottom:30px;display:grid;grid-template-columns:1fr 1.5fr;gap:75px}.faq h2{font-size:31px;font-weight:600;max-width:11ch}.faq details{border-top:1px solid var(--line);padding:20px 0}.faq summary{list-style:none;display:flex;align-items:center;justify-content:space-between;gap:18px;font-weight:600;font-size:16px;cursor:pointer}.faq summary::-webkit-details-marker{display:none}.faq summary svg{width:18px;height:18px;color:var(--muted);transition:transform .18s ease-out}.faq details[open] summary svg{transform:rotate(180deg)}.faq details p{font-size:15px;color:var(--muted);line-height:1.7;margin-top:15px;max-width:65ch}.faq a{color:var(--accent)}.mini-footer{padding-top:35px;padding-bottom:35px;display:flex;align-items:center;justify-content:space-between;gap:20px;font-size:12px;color:var(--muted)}.mini-footer .brand{font-size:16px;color:var(--ink)}
 @media(min-width:1600px){.opening{padding-top:60px;padding-bottom:50px}.intro{margin-bottom:38px}}
 @media(max-width:1000px){.mini-header{padding:16px 24px;gap:18px}.mini-header nav{gap:17px}.header-download{display:none}.opening{padding:38px 28px}.section-wrap{padding-left:28px;padding-right:28px}.section-heading,.compatibility-inner,.install,.faq{gap:38px}.plugin{padding:20px 15px;grid-template-columns:34px 1fr;gap:11px}.plugin-icon{width:34px;height:34px}.plugin h3{font-size:15px}.feature-list{column-gap:38px}.display-pair{gap:12px}.tiny-island{font-size:7px;gap:3px}}
 @media(max-width:700px){.section-heading{grid-template-columns:1fr;gap:22px}.feature-list{grid-template-columns:1fr;gap:28px;margin-top:32px}.features,.plugins{padding-top:56px;padding-bottom:56px}.compatibility-inner{grid-template-columns:1fr}.compatibility{padding:45px 0}.display-pair{max-width:440px;width:100%;margin:auto}.compatibility-copy{max-width:55ch}.plugin-catalog{grid-template-columns:repeat(2,1fr)}.install,.faq{grid-template-columns:1fr;gap:37px}.install{padding-top:45px;padding-bottom:30px}.faq{padding-top:40px}.faq h2{max-width:none}.mini-footer{flex-wrap:wrap}.intro-actions{flex-direction:column;gap:10px}.intro>p{font-size:15px}.opening{padding:33px 20px 30px}.intro{margin-bottom:22px}.mini-header{flex-wrap:wrap;gap:12px;padding:14px 20px}.mini-header nav{order:3;width:100%;justify-content:center;margin:0;padding-top:9px}.header-actions{margin-left:auto}.brand{font-size:19px}.brand img{width:33px;height:33px}.section-wrap{padding-left:22px;padding-right:22px}.plugin h3{font-size:14px}.plugin{grid-template-columns:1fr;padding:17px}.plugin-icon{margin-bottom:3px}.plugin-meta{grid-column:1;align-items:flex-start;flex-direction:column;gap:8px;margin-top:12px}.section-heading h2,.compatibility h2,.install h2{font-size:33px}.tiny-island{font-size:8px}.faq{gap:25px}}
</style>
<style>.opening{background-color:#091d29;background-image:url('/images/minitools/tidal-wallpaper.png');background-size:cover;background-position:center}.opening :global(.activity[aria-pressed=true]){background:#164653f2}.opening :global(.activity:hover){background:#1b5060f2}@media(max-width:700px){.opening{background-position:41% center}}</style>
