---
import Layout from '../layouts/ProposalLayout.astro';
import T from './ProposalText.astro';
import SupportLinks from './SupportLinks.astro';
import MiniToolsMark from './MiniToolsMark.astro';
import MiniToolsIcon from './MiniToolsIcon.astro';
import PortfolioHero from './portfolio/PortfolioHero.astro';
import DeveloperStack from './portfolio/DeveloperStack.astro';
import ExperienceTimeline from './portfolio/ExperienceTimeline.astro';
import OwnProjects from './portfolio/OwnProjects.astro';
import SocialLinks from './portfolio/SocialLinks.astro';
import ContactForm from './portfolio/ContactForm.astro';
import EducationSection from './portfolio/EducationSection.astro';
import PortfolioPreloader from './portfolio/PortfolioPreloader.astro';
import '../styles/portfolio.css';
const filters = [{id:'all',en:'All work',es:'Todo'}, {id:'native',en:'Native apps',es:'Apps nativas'}, {id:'web',en:'Web & platforms',es:'Web y plataformas'}, {id:'experiments',en:'Experiments',es:'Experimentos'}];
const { showFaq = false } = Astro.props;
---
<Layout title="Luis Gil — Software Developer Engineer" description="Software Developer Engineer and independent product creator. Web platforms, native apps and backend systems. Creator of Hourmeet and founder of Luromi Studio." titleEs="Luis Gil — Software Developer Engineer" descriptionEs="Software Developer Engineer y creador de productos independientes. Plataformas web, apps nativas y sistemas backend. Creador de Hourmeet y fundador de Luromi Studio." socialImage="/images/social/portfolio-2026.png?v=3" socialImageAlt="Luis Gil — Software Developer Engineer. Backend, web and native apps." socialImageAltEs="Luis Gil — Software Developer Engineer. Backend, web y apps nativas." theme="portfolio" initialTheme="dark" fixedTheme="dark">
  <PortfolioPreloader/>
  <main id="content">
    <header class="portfolio-topbar" data-menu-open="false">
      <span class="header-divider" aria-hidden="true"><span class="header-divider-glint"></span></span>
      <div class="mobile-header">
        <a class="mobile-brand" href="#home" aria-label="Luis Gil, home"><span aria-hidden="true">&gt;_</span></a>
        <div class="header-settings mobile-settings"><button data-language aria-label="Cambiar a español">ES</button><button class="mobile-menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-navigation-drawer" aria-haspopup="dialog"><svg viewBox="0 0 24 24" aria-hidden="true"><path class="menu-bars" d="M4 7h16M4 12h16M4 17h16"/><path class="menu-close" d="m6 6 12 12M18 6 6 18"/></svg><T class="menu-label" en="Menu" es="Menú"/></button></div>
      </div>
      <nav class="portfolio-navigation" id="portfolio-navigation" aria-label="Main navigation">
      <a class="desktop-terminal" href="#home" aria-label="Luis Gil, home">&gt;_</a>
      <a href="#home" aria-current="location"><T en="Home" es="Inicio"/></a>
      <a href="#work"><T en="My work" es="Mi trabajo"/></a>
      <a href="#stack"><T en="Tech stack" es="Tecnologías"/></a>
      <a href="#experience"><T en="Experience" es="Experiencia"/></a>
      <a href="#education"><T en="Education" es="Formación"/></a>
      <a href="#about"><T en="About me" es="Sobre mí"/></a>
      <div class="header-actions">
        <div class="header-settings"><button data-language aria-label="Cambiar a español">ES</button></div>
        <a class="top-contact" href="#contact"><T en="Let's talk" es="Hablemos"/></a>
      </div>
      </nav>
      <dialog class="mobile-drawer" id="mobile-navigation-drawer" aria-labelledby="drawer-title">
        <div class="drawer-heading"><T as="h2" id="drawer-title" tabindex="-1" autofocus en="Explore" es="Explora"/><button type="button" class="drawer-close"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg><T class="menu-label" en="Close menu" es="Cerrar menú"/></button></div>
      </dialog>
      <noscript><style is:inline>@media(max-width:760px){.portfolio-topbar > .portfolio-navigation{display:grid!important}}</style></noscript>
    </header>
    <PortfolioHero/>
    <section id="work" aria-label="Projects">
      <div class="work-toolbar"><T as="h2" en="From an idea to a product." es="De la idea al producto."/><div class="filters" role="group" aria-label="Project filters">{filters.map(f=><button data-filter={f.id} aria-pressed={f.id==='all' ? 'true' : 'false'}><T en={f.en} es={f.es}/></button>)}</div></div>
      <div class="projects">
        <OwnProjects/>
        <article class="project tavi-project" data-category="native">
          <div class="tavi-copy"><img class="app-icon" src="/images/tavi/tavi-mark.png" width="52" height="52" alt=""/><h3>Tavi</h3><T as="p" en="An API client that feels right at home on your Mac." es="Un cliente API que se siente en casa en tu Mac."/><span class="project-stack">SwiftUI · macOS · iPadOS</span><a class="open-project" href="/apps/tavi/"><T en="Meet Tavi" es="Conoce Tavi"/></a></div>
          <div class="tavi-art"><div class="screenshot-caption"><span>Tavi</span><T en="Your requests, in one place." es="Tus requests, en un solo lugar."/></div><img src="/images/tavi/macos-response.jpg" alt="Tavi running on macOS with a request and JSON response" width="1699" height="935" loading="lazy" decoding="async"/></div>
        </article>
        <article class="project minitools-project" data-category="native">
          <div class="minitools-copy"><MiniToolsMark size={46}/><h3>MiniTools</h3><T as="p" en="Music, timers and your day, right at the top of your Mac. A useful island with or without a notch." es="Música, temporizadores y tu día, en la parte superior de tu Mac. Una isla útil con o sin notch."/><span class="project-stack">SwiftUI · macOS 13+ · Apple silicon</span><a class="open-project" href="/apps/minitools/"><T en="Explore MiniTools" es="Descubre MiniTools"/></a></div>
          <div class="minitools-art"><div class="minitools-art-caption"><span>MiniTools</span><T en="Illustrative island preview" es="Vista ilustrativa de la isla"/></div><div class="minitools-screen" aria-hidden="true"><div class="minitools-bezel"></div><div class="minitools-island"><div class="minitools-island-top"><span class="minitools-album">EW</span><span>Evening Walk</span><span>25:00</span></div><div class="minitools-island-tabs"><span>Music</span><span>Timers</span><span>ToDo</span></div><div class="minitools-island-body"><div class="minitools-artwork">EW</div><div class="minitools-track"><strong>Evening Walk</strong><span>Luis Gil · Demo playlist</span><div class="minitools-progress"><i></i></div><div class="minitools-playback"><MiniToolsIcon name="previous"/><MiniToolsIcon name="play"/><MiniToolsIcon name="next"/></div></div></div></div></div></div>
        </article>
        <article class="project nextup-project" data-category="native">
          <div class="project-heading"><h3>NextUp</h3><T class="project-status" en="In development" es="En desarrollo"/></div>
          <T as="p" en="Turn the everyday into progress you can see." es="Convierte lo cotidiano en progreso que puedes ver."/>
          <div class="task-preview"><div class="task-title"><T en="A little progress, every day." es="Un pequeño avance, cada día."/><span>NextUp</span></div><label><input type="checkbox"/><T en="Make time to read" es="Hacer tiempo para leer"/></label><label><input type="checkbox" checked/><T en="Finish a personal project" es="Terminar un proyecto personal"/></label><label><input type="checkbox"/><T en="Try something new" es="Probar algo nuevo"/></label><T class="preview-note" en="Illustrative interaction · try checking a task" es="Interacción ilustrativa · marca una tarea"/></div>
          <details><summary><T en="What I'm building" es="Qué estoy construyendo"/></summary><T as="p" en="A SwiftUI app with tasks, routines, points and rewards. I develop the architecture, persistence, tests and Firebase synchronization." es="Una app SwiftUI con tareas, rutinas, puntos y recompensas. Desarrollo su arquitectura, persistencia, pruebas y sincronización con Firebase."/></details>
        </article>
        <article class="project umbral-project" data-category="experiments">
          <div class="project-heading"><h3>Umbral</h3><T class="project-status" en="In development" es="En desarrollo"/></div><T as="p" en="Giving e-paper a life beyond the next page." es="Dándole vida al e-paper más allá de la siguiente página."/>
          <div class="epaper-preview" aria-label="Illustrative e-paper interface"><div class="reader-display"><span>Umbral</span><strong>08:24</strong><T as="p" en="A good day to unplug." es="Un buen día para desconectar."/><div><T en="Library" es="Biblioteca"/><T en="Calendar" es="Calendario"/></div></div><div class="reader-controls" aria-hidden="true"><i></i><i></i><i></i></div></div><T as="p" class="preview-note" en="Illustrative interface for Xteink X3" es="Interfaz ilustrativa para Xteink X3"/>
          <details><summary><T en="Explore the idea" es="Explorar la idea"/></summary><T as="p" en="Custom firmware with themes, SD-based apps and a Standby mode with clock, weather and calendar." es="Firmware con temas, apps desde la SD y un modo Standby con reloj, clima y calendario."/></details>
        </article>
        <article class="project compact-project" data-category="experiments"><div><h3>UpToDown</h3><T as="p" en="One idea. Several perspectives. A local forum where AI agents discuss and vote." es="Una idea. Varias perspectivas. Un foro local donde agentes de IA debaten y votan."/></div><details><summary><T en="Local prototype" es="Prototipo local"/></summary><T as="p" en="React, TypeScript, Node.js and SQLite, with secure Codex orchestration." es="React, TypeScript, Node.js y SQLite, con orquestación segura de Codex."/></details></article>
      </div>
      <p class="filter-announcement" aria-live="polite"></p>
    </section>
    <DeveloperStack/>
    <ExperienceTimeline/>
    <EducationSection/>
    <section id="about" class="about"><div><T as="h2" en="I build, connect and keep learning." es="Construir, conectar y seguir aprendiendo."/><T as="p" en="I want to understand what a product needs to solve and how its pieces fit together. I connect backend, data and interfaces with one goal: a solution that makes sense to the people using it. My own products give me room to explore ideas and keep learning with each version." es="Me interesa entender qué necesita resolver un producto y cómo encajan sus piezas. Conecto backend, datos e interfaces con una misma intención: que la solución tenga sentido para quien la usa. En mis proyectos propios encuentro espacio para explorar ideas y seguir aprendiendo con cada versión."/><div class="personal-reflection"><T as="h3" en="Learning to live in a world that isn’t always designed for the way I think." es="Aprender a vivir en un mundo que no siempre está diseñado para mi forma de pensar."/><T as="p" en="I’m autistic and have inattentive ADHD. Getting to know myself has been part of learning to navigate a world that often takes other ways of perceiving, processing and organizing life for granted. That learning means recognizing my strengths, my limits and the strategies that work for me. It’s an ongoing process of self-knowledge that is part of my story and the person behind these projects." es="Soy autista y tengo TDAH de presentación inatenta. Conocerme ha sido parte de aprender a moverme en un mundo que suele dar por sentadas otras formas de percibir, procesar y organizar la vida. Ese aprendizaje implica reconocer mis fortalezas, mis límites y las estrategias que me funcionan. Es un proceso continuo de autoconocimiento que forma parte de mi historia y de la persona detrás de estos proyectos."/></div></div></section>
    {showFaq && <section class="portfolio-faq" aria-labelledby="portfolio-faq-title">
      <T as="h2" id="portfolio-faq-title" en="A few useful questions." es="Algunas preguntas útiles." />
      <div class="portfolio-faq-list">
        <details><summary><T en="Which projects can I explore now?" es="¿Qué proyectos puedo explorar ahora?"/></summary><T as="p" en="Open the Tavi and MiniTools pages for product details. NextUp, Umbral and UpToDown are personal projects in development, with previews that explain the ideas." es="Abre las páginas de Tavi y MiniTools para conocer sus detalles. NextUp, Umbral y UpToDown son proyectos personales en desarrollo; sus vistas ilustran las ideas."/></details>
        <details><summary><T en="Are the project previews live apps?" es="¿Las vistas de los proyectos son apps reales?"/></summary><T as="p" en="The Tavi image shows its actual macOS interface. The MiniTools island and the previews for projects in development are illustrative views." es="La imagen de Tavi muestra su interfaz real para macOS. La isla de MiniTools y las vistas de los proyectos en desarrollo son ilustrativas."/></details>
        <details><summary><T en="What kind of work do you do?" es="¿Qué tipo de trabajo haces?"/></summary><T as="p" en="My experience spans backend services, APIs, mobile development and native Apple platform apps. The experience and technology sections above include the details." es="Mi experiencia abarca servicios backend, APIs, desarrollo móvil y apps nativas para plataformas Apple. Las secciones anteriores detallan mi experiencia y tecnologías."/></details>
        <details><summary><T en="How can I get in touch?" es="¿Cómo puedo contactarte?"/></summary><p><T en="Email me about a role, a product idea or a technical collaboration: " es="Escríbeme sobre una vacante, una idea de producto o una colaboración técnica: "/><a href="#contact-form">luis.gil.dev15@gmail.com</a>.</p></details>
      </div>
    </section>}
    <section id="contact" class="portfolio-contact"><T as="h2" en="Let’s talk about&#10;what’s next." es="Hablemos de&#10;lo que sigue."/><a href="#contact-form">luis.gil.dev15@gmail.com</a><ContactForm/></section>
    <SupportLinks/>
    <footer><SocialLinks/><div class="footer-meta"><span>Luis Gil © 2026</span></div></footer>
  </main>
  <script>
    import '../scripts/portfolio-motion';
    import '../scripts/portfolio-disclosures';
    const navigationLinks = document.querySelectorAll<HTMLAnchorElement>('.portfolio-navigation a[href^="#"]');
    const navigationSections = [...navigationLinks].map(link => document.querySelector<HTMLElement>(link.hash)).filter((section): section is HTMLElement => Boolean(section));
    function updateActiveNavigation() {
      const scrollPadding = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
      const threshold = (document.querySelector('.portfolio-topbar')?.getBoundingClientRect().bottom ?? 0) + 40 + scrollPadding;
      let active = navigationSections[0];
      for (const section of navigationSections) {
        if (section.getBoundingClientRect().top <= threshold) active = section;
      }
      navigationLinks.forEach(link => {
        if (active && link.hash === '#' + active.id) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    }
    let navigationFrame = 0;
    window.addEventListener('scroll', () => {
      if (navigationFrame) return;
      navigationFrame = requestAnimationFrame(() => { updateActiveNavigation(); updateHeaderEdge(); navigationFrame = 0; });
    }, { passive: true });
    window.addEventListener('resize', updateActiveNavigation);
    const topbar = document.querySelector<HTMLElement>('.portfolio-topbar');
    const menuButton = topbar?.querySelector<HTMLButtonElement>('.mobile-menu-toggle');
    const mobileBreakpoint = matchMedia('(max-width:760px)');
    const headerReducedMotion = matchMedia('(prefers-reduced-motion:reduce)');
    const headerGlint = topbar?.querySelector<HTMLElement>('.header-divider-glint');
    let headerGlintAnimation:Animation|undefined;
    let headerScrolled = window.scrollY > 16;
    if (topbar) {
      topbar.dataset.scrolled = String(headerScrolled);
      topbar.dataset.edgeReady = '';
    }
    function updateHeaderEdge() {
      const next = headerScrolled ? window.scrollY > 2 : window.scrollY > 16;
      if (!topbar || next === headerScrolled) return;
      headerScrolled = next;
      topbar.dataset.scrolled = String(next);
      if (!headerGlint) return;
      const opacity = getComputedStyle(headerGlint).opacity;
      headerGlintAnimation?.cancel();
      if (!mobileBreakpoint.matches || headerReducedMotion.matches) return;
      headerGlintAnimation = headerGlint.animate([
        {opacity}, {opacity:next ? .8 : .35,offset:.5}, {opacity:0},
      ], {duration:320,easing:'cubic-bezier(.4,0,.6,1)'});
    }
    const stopHeaderGlint = () => headerGlintAnimation?.cancel();
    headerReducedMotion.addEventListener('change',stopHeaderGlint);
    mobileBreakpoint.addEventListener('change',stopHeaderGlint);
    const drawer = topbar?.querySelector<HTMLDialogElement>('.mobile-drawer');
    const navigation = topbar?.querySelector<HTMLElement>('.portfolio-navigation');
    if (topbar && menuButton && drawer && navigation) {
      let drawerEntrance:Animation|undefined;
      const closeMenu = () => { if (drawer.open) drawer.close(); };
      const placeNavigation = () => {
        closeMenu();
        if (mobileBreakpoint.matches) drawer.append(navigation);
        else drawer.before(navigation);
      };
      placeNavigation();
      topbar.dataset.menuReady='true';
      drawer.addEventListener('close',() => {
        drawerEntrance?.cancel();
        topbar.dataset.menuOpen='false';
        menuButton.setAttribute('aria-expanded','false');
        document.documentElement.classList.remove('portfolio-menu-open');
      });
      menuButton.addEventListener('click',() => {
        if (!mobileBreakpoint.matches || drawer.open) return;
        drawer.showModal();
        drawer.querySelector<HTMLElement>('#drawer-title')?.focus({preventScroll:true});
        topbar.dataset.menuOpen='true';
        menuButton.setAttribute('aria-expanded','true');
        document.documentElement.classList.add('portfolio-menu-open');
        if (!matchMedia('(prefers-reduced-motion:reduce)').matches) {
          drawerEntrance?.cancel();
          drawerEntrance=drawer.animate([{transform:'translateX(100%)'},{transform:'translateX(0)'}],{duration:280,easing:'cubic-bezier(.16,1,.3,1)'});
        }
      });
      drawer.querySelector('.drawer-close')?.addEventListener('click',closeMenu);
      drawer.addEventListener('click',event => {
        const bounds=drawer.getBoundingClientRect();
        if (event.target===drawer && (event.clientX<bounds.left || event.clientX>bounds.right || event.clientY<bounds.top || event.clientY>bounds.bottom)) closeMenu();
      });
      topbar.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach(link => link.addEventListener('click',() => {
        if (!mobileBreakpoint.matches) return;
        closeMenu();
        const target=document.querySelector<HTMLElement>(link.hash);
        target?.setAttribute('tabindex','-1');
        target?.focus({preventScroll:true});
      }));
      mobileBreakpoint.addEventListener('change',placeNavigation);
      window.addEventListener('pageshow',closeMenu);
    }
    if (topbar) new ResizeObserver(() => {
      document.body.style.setProperty('--portfolio-header-height', `${topbar.getBoundingClientRect().height}px`);
      updateActiveNavigation();
    }).observe(topbar);
    updateActiveNavigation();
    document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button => button.addEventListener('click', event => {
      const filter = button.dataset.filter;
      document.querySelectorAll('[data-filter]').forEach(b=>b.setAttribute('aria-pressed', String(b===button)));
      let count = 0;
      document.querySelectorAll<HTMLElement>('[data-category]').forEach(project=>{
        project.hidden = filter !== 'all' && project.dataset.category !== filter;
        if (!project.hidden) count++;
      });
      document.dispatchEvent(new CustomEvent('portfolio-filter',{detail:{keyboard:event.detail===0}}));
      const status = document.querySelector('.filter-announcement');
      if(status) status.textContent = document.documentElement.lang === 'es' ? count + ' proyectos visibles' : count + ' projects shown';
    }));
  </script>
</Layout>
<style>
  .task-preview{background:#fff9f4;border-radius:12px;padding:20px;margin-top:32px;color:#4b352e;box-shadow:0 12px 25px #6b403414}.task-title{display:flex;justify-content:space-between;gap:12px;font-size:12px;font-weight:600;margin-bottom:14px}.task-title>span:last-child{font-size:9px;color:#895e50}.task-preview label{display:flex;align-items:center;gap:10px;padding:12px 0;font-size:12px;cursor:pointer}.task-preview input{accent-color:#9b463e;width:17px;height:17px;flex-shrink:0}.task-preview input:checked+span{text-decoration:line-through;color:#81645b}.umbral-project>.preview-note{color:var(--muted)}
  .epaper-preview{width:185px;background:#30352e;border-radius:16px;padding:12px;margin:26px auto 0;transform:rotate(-5deg);box-shadow:0 12px 20px #33382d22}.reader-display{background:#f5f5e9;color:#292d26;padding:12px 11px}.reader-display>span{font-size:10px;font-weight:700}.reader-display strong{display:block;font-size:36px;font-weight:500;letter-spacing:-.04em;margin:17px 0 3px}.reader-display p{font-size:8px}.reader-display>div{display:flex;justify-content:space-between;margin-top:25px;font-size:8px;border-top:1px solid #999f8f;padding-top:10px}.reader-controls{display:flex;gap:16px;justify-content:center;margin:10px auto 0}.reader-controls i{width:5px;height:5px;border:1px solid #c5cabe;border-radius:50%}
  :global([data-theme=dark]) .task-preview{background:var(--page);color:var(--ink);box-shadow:none}
  :global([data-theme=dark]) .task-title>span:last-child,:global([data-theme=dark]) .task-preview .preview-note,:global([data-theme=dark]) .task-preview input:checked+span{color:var(--muted)}
  :global([data-theme=dark]) .task-preview input{accent-color:var(--accent)}
  .minitools-bezel{height:8px;background:#050607}
  .minitools-island{width:min(75%,380px);min-width:260px;margin:0 auto;background:#050607;color:#f5f7f7;border-radius:0 0 18px 18px;padding:0 18px 19px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;box-shadow:0 17px 26px #0006}
  .minitools-island-top{display:flex;align-items:center;gap:8px;min-height:41px;font-size:11px;font-weight:600}
  .minitools-album{display:grid;place-items:center;width:24px;height:24px;border-radius:6px;background:#476e9c;color:#fff;font-size:9px}
  .minitools-island-tabs{display:flex;gap:6px;border-top:1px solid #ffffff1a;padding:9px 0 12px;font-size:10px;color:#a9b4bc}
  .minitools-island-tabs span{padding:5px 9px}
  .minitools-island-tabs span:first-child{background:#34383b;color:#fff;border-radius:14px}
  .minitools-island-body{display:flex;gap:13px;align-items:center}
  .minitools-artwork{display:grid;place-items:center;width:66px;height:66px;flex-shrink:0;border-radius:9px;background:#476e9c;color:#e9f2ff;font-size:23px;font-weight:500}
  .minitools-track{flex:1;min-width:0}.minitools-track strong,.minitools-track>span{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.minitools-track strong{font-size:12px}.minitools-track>span{font-size:10px;color:#bac5ce;margin-top:3px}
  .minitools-progress{height:3px;background:#626970;border-radius:3px;margin-top:11px}.minitools-progress i{display:block;width:38%;height:100%;background:#e7eef3;border-radius:inherit}
  .minitools-playback{display:flex;align-items:center;justify-content:center;gap:19px;margin-top:8px}.minitools-playback :global(svg){width:13px;height:13px}
  @media(max-width:760px){.minitools-island{min-width:0;width:86%}.minitools-artwork{width:52px;height:52px}}
</style>
