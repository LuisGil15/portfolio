---
import Layout from '../layouts/ProposalLayout.astro';
import T from './ProposalText.astro';
import TaviHeader from './TaviHeader.astro';
import TaviFooter from './TaviFooter.astro';
import TaviPlayground from './TaviPlayground.astro';
const faqs = [
  {en:'Do I need an account?',es:'¿Necesito una cuenta?',ae:'No. Tavi works without a developer account. Your workspaces are stored locally, and iCloud synchronization is optional.',as:'No. Tavi funciona sin una cuenta del desarrollador. Tus espacios se guardan localmente y la sincronización con iCloud es opcional.'},
  {en:'Where are my credentials stored?',es:'¿Dónde se guardan mis credenciales?',ae:'Secrets are stored in Apple Keychain. Tavi does not include third-party analytics, advertising or tracking.',as:'Los secretos se guardan en el Llavero de Apple. Tavi no incluye analítica de terceros, publicidad ni rastreo.'},
  {en:'Can I use variables and environments?',es:'¿Puedo usar variables y ambientes?',ae:'Yes. Organize requests into workspaces and folders, then use environments and variables to reuse your configuration.',as:'Sí. Organiza requests en espacios y carpetas; usa ambientes y variables para reutilizar tu configuración.'},
  {en:'Where can I download Tavi?',es:'¿Dónde puedo descargar Tavi?',ae:'Get Tavi for iPad and Mac from the App Store, or download the direct macOS build from GitHub. Homebrew is also available to users with access to the private tap.',as:'Descarga Tavi para iPad y Mac desde App Store, o la versión directa para macOS desde GitHub. Homebrew también está disponible para quienes tienen acceso al tap privado.'}
];
---
<Layout title="Tavi — A better place to work with APIs" description="A native HTTP client for macOS and iPadOS. Explore an interactive example and discover Tavi." socialImageAlt="Tavi, a native API workspace for Mac and iPad" theme="tavi">
  <TaviHeader/>
  <main id="content">
    <section class="opening">
      <div class="opening-copy"><div><h1><T en="An API client.&#10;Your APIs.&#10;Your workspace." es="Un cliente API.&#10;Tus APIs.&#10;Tu espacio de trabajo."/></h1><T as="p" class="opening-tagline" en="Right at home on Mac and iPad." es="Como en casa, en Mac y iPad."/></div><div><T as="p" en="Send a request. Understand the response. Keep everything together in a native workspace for Mac and iPad." es="Envía una solicitud. Entiende la respuesta. Reúne todo en un espacio nativo para Mac y iPad."/><a href="#playground"><T en="Try a request below" es="Prueba una solicitud abajo"/><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v16m-6-6 6 6 6-6"/></svg></a></div></div>
      <TaviPlayground/>
      <div class="opening-bottom"><span>macOS & iPadOS</span><T en="Native SwiftUI interface" es="Interfaz nativa con SwiftUI"/><T en="No account required" es="Sin necesidad de una cuenta"/></div>
    </section>
    <section id="native" class="native-section">
      <div class="section-copy"><h2><T en="Same workspace.&#10;Different places." es="El mismo espacio.&#10;Distintos lugares."/></h2><T as="p" en="At your desk or away from it, your tools should feel familiar. Tavi adapts to the way you work on each device." es="En tu escritorio o fuera de él, tus herramientas deben sentirse familiares. Tavi se adapta a cómo trabajas en cada dispositivo."/></div>
      <div class="platform-switch" role="group" aria-label="Platform"><button data-platform="mac" aria-pressed="true"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="13" rx="2"/><path d="M12 16v5m-5 0h10"/></svg>macOS</button><button data-platform="ipad" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="2" width="16" height="20" rx="2"/><path d="M10 19h4"/></svg>iPadOS</button></div>
      <figure class="product-capture"><img id="platform-image" src="/images/tavi/macos-response.jpg" alt="Tavi on macOS" width="1800" height="1100" loading="lazy"/><figcaption><span id="platform-caption">macOS</span><T en="Actual Tavi interface" es="Interfaz real de Tavi"/></figcaption></figure>
      <div class="native-notes"><div><h3><T en="Everything has a place." es="Cada cosa en su lugar."/></h3><T as="p" en="Workspaces, folders and history keep a quick test from becoming a lost request." es="Espacios, carpetas e historial para que una prueba rápida no se convierta en una solicitud perdida."/></div><div><h3><T en="Your setup goes with you." es="Tu configuración te acompaña."/></h3><T as="p" en="Reuse environments and variables. Turn on optional iCloud sync when you want your workspace on another device." es="Reutiliza ambientes y variables. Activa iCloud si quieres llevar tu espacio a otro dispositivo."/></div></div>
    </section>
    <section class="privacy-section"><svg class="privacy-icon" viewBox="0 0 48 48" aria-hidden="true"><rect x="10" y="20" width="28" height="22" rx="5"/><path d="M16 20v-7a8 8 0 0 1 16 0v7M24 29v5"/></svg><div><h2><T en="Your work is your business." es="Tu trabajo es asunto tuyo."/></h2><T as="p" en="No advertising. No analytics. No account to get started. Credentials are stored in Apple Keychain, and your workspaces stay under your control." es="Sin anuncios. Sin analítica. Sin una cuenta para empezar. Las credenciales se guardan en el Llavero de Apple y tus espacios siguen bajo tu control."/></div><a href="/apps/tavi/privacy/"><T en="Read the privacy policy" es="Leer la política de privacidad"/></a></section>
    <section id="questions" class="questions"><div><h2><T en="Before you ask." es="Antes de que preguntes."/></h2><T as="p" en="A few things worth knowing." es="Algunas cosas que vale la pena saber."/><a href="/apps/tavi/support/"><T en="Need a hand?" es="¿Necesitas ayuda?"/></a></div><div class="faq-list">{faqs.map(f=><details><summary><T en={f.en} es={f.es}/><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary><T as="p" en={f.ae} es={f.as}/></details>)}</div></section>
    <section class="availability" id="availability" aria-labelledby="availability-title">
      <div class="availability-heading"><img src="/images/tavi/tavi-mark.png" alt="" width="56" height="56"/><div><h2 id="availability-title"><T en="Tavi is ready." es="Tavi ya está disponible."/></h2><T as="p" en="Choose the version that fits your workflow." es="Elige la versión que mejor se adapte a tu flujo de trabajo."/></div></div>
      <div class="download-options">
        <a class="download-option store-option" href="https://apps.apple.com/mx/app/tavi/id6819794965" target="_blank" rel="noreferrer" aria-label="Tavi on the App Store for iPad and Mac"><img id="app-store-badge" class="app-store-badge" src="/images/tavi/app-store-badge-white-en.svg" width="150" height="50" alt="Download on the App Store" loading="lazy" decoding="async"/><span class="option-detail"><T en="iPad · Mac" es="iPad · Mac"/></span></a>
        <a class="download-option" href="https://github.com/LuisGil15/tavi/releases/latest" target="_blank" rel="noreferrer"><span class="option-label"><T en="Direct download" es="Descarga directa"/></span><span class="option-detail"><T en="macOS · GitHub release" es="macOS · Release de GitHub"/></span><span class="option-arrow" aria-hidden="true">↗</span></a>
        <div class="download-option brew-option"><a class="brew-link" href="https://github.com/LuisGil15/homebrew-tavi" target="_blank" rel="noreferrer"><span class="option-label">Homebrew</span><span class="option-arrow" aria-hidden="true">↗</span></a><code>brew tap LuisGil15/tavi<br/>brew install --cask tavi</code><span class="option-detail"><T en="Requires access to the private tap." es="Requiere acceso al tap privado."/></span></div>
      </div>
    </section>
  </main>
  <TaviFooter/>
  <script>
    document.querySelectorAll<HTMLButtonElement>('[data-platform]').forEach(button=>button.addEventListener('click',()=>{
      const mac=button.dataset.platform==='mac';
      document.querySelectorAll('[data-platform]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));
      const image=document.querySelector<HTMLImageElement>('#platform-image')!;
      image.src=mac?'/images/tavi/macos-response.jpg':'/images/tavi/request-response.jpg';
      image.alt=mac?'Tavi · macOS':'Tavi · iPadOS';
      document.querySelector('#platform-caption')!.textContent=mac?'macOS':'iPadOS';
    }));
    const appStoreBadge = document.querySelector<HTMLImageElement>('#app-store-badge');
    const updateAppStoreBadge = () => {
      if (!appStoreBadge) return;
      const spanish = document.documentElement.lang.toLowerCase().startsWith('es');
      const artwork = document.documentElement.dataset.theme === 'dark' ? 'white' : 'black';
      const locale = spanish ? 'es' : 'en';
      appStoreBadge.src = `/images/tavi/app-store-badge-${artwork}-${locale}.svg`;
      appStoreBadge.alt = spanish ? 'Descargar en App Store' : 'Download on the App Store';
    };
    updateAppStoreBadge();
    new MutationObserver(updateAppStoreBadge).observe(document.documentElement, { attributes: true, attributeFilter: ['lang', 'data-theme'] });
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (!reduceMotion.matches && 'IntersectionObserver' in window) {
      const targets = document.querySelectorAll<HTMLElement>(
        '.opening-copy, .playground, .opening-bottom, .native-section > .section-copy, .platform-switch, .product-capture, .native-notes, .privacy-section, .questions > div, .faq-list details, .availability'
      );
      const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -5% 0px' });
      targets.forEach((element, index) => {
        element.classList.add('scroll-reveal');
        if (element.matches('.playground')) element.style.setProperty('--reveal-delay', '90ms');
        if (element.matches('.opening-bottom, .product-capture')) element.style.setProperty('--reveal-delay', '170ms');
        if (element.matches('.faq-list details')) element.style.setProperty('--reveal-delay', String(Math.min(index * 28, 140)) + 'ms');
        observer.observe(element);
      });
      if (targets.length) document.documentElement.classList.add('motion-ready');
    }
  </script>
</Layout>
<style>
  .opening-copy .opening-tagline{margin-top:20px;font-size:clamp(18px,2vw,23px);line-height:1.4;max-width:none}
  svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
  .opening{background:var(--opening);color:#fff;padding:48px max(32px,calc((100vw - 1160px)/2)) 25px}.opening-copy{display:grid;grid-template-columns:1.35fr 1fr;gap:80px;align-items:end;margin-bottom:38px}.opening h1{font-size:clamp(38px,4.5vw,61px);font-weight:650;white-space:pre-line;line-height:1.08}.opening-copy p{font-size:18px;line-height:1.55;color:#e6efff;max-width:420px}.opening-copy a{display:inline-flex;align-items:center;gap:8px;color:#fff;font-size:14px;margin-top:18px;text-decoration:none}
  .opening-bottom{display:flex;justify-content:center;gap:50px;font-size:12px;color:#e6efff;margin-top:23px}.native-section{max-width:1160px;margin:100px auto;padding:0 30px}.section-copy{display:grid;grid-template-columns:1fr 1fr;gap:90px;align-items:end}.section-copy h2{font-size:44px;white-space:pre-line}.section-copy p{font-size:17px;line-height:1.7;color:var(--muted);max-width:410px}.platform-switch{display:flex;justify-content:center;gap:6px;margin:35px 0 25px}.platform-switch button{display:flex;align-items:center;gap:10px;border:0;border-radius:8px;background:var(--soft);color:var(--muted);font-size:13px;padding:11px 20px}.platform-switch button[aria-pressed=true]{background:var(--selected);color:var(--accent)}.platform-switch svg{width:18px;height:18px}.product-capture{background:var(--tint);border-radius:16px;padding:38px 38px 19px}.product-capture img{width:100%;height:auto;border-radius:9px;box-shadow:0 12px 26px #29467522}.product-capture figcaption{display:flex;justify-content:space-between;font-size:11px;color:var(--muted);margin-top:19px}.native-notes{display:grid;grid-template-columns:1fr 1fr;gap:70px;margin-top:35px}.native-notes h3{font-size:22px}.native-notes p{margin-top:13px;line-height:1.7;font-size:16px;color:var(--muted)}
  .privacy-section{background:var(--tint);padding:50px max(35px,calc((100vw - 1100px)/2));display:grid;grid-template-columns:60px 1fr auto;align-items:center;gap:28px}.privacy-icon{width:48px;height:48px;color:var(--accent);stroke-width:1.5}.privacy-section h2{font-size:30px}.privacy-section p{font-size:16px;line-height:1.7;max-width:540px;color:var(--muted);margin-top:15px}.privacy-section>a{font-size:13px;color:var(--accent);max-width:170px}
  .questions{max-width:1160px;margin:100px auto;padding:0 30px;display:grid;grid-template-columns:.85fr 1.3fr;gap:65px}.questions h2{font-size:37px}.questions>div>p{margin:16px 0 20px;color:var(--muted)}.questions a{color:var(--accent);font-size:15px}.faq-list details{border-bottom:1px solid var(--line);padding:21px 0}.faq-list details:first-child{padding-top:0}.faq-list summary{list-style:none;display:flex;justify-content:space-between;gap:22px;font-weight:600;font-size:17px;cursor:pointer}.faq-list summary::-webkit-details-marker{display:none}.faq-list summary svg{color:var(--accent);transition:transform .18s}.faq-list details[open] svg{transform:rotate(180deg)}.faq-list details p{color:var(--muted);font-size:15px;line-height:1.7;margin-top:17px}
  .availability{max-width:1100px;margin:0 auto 85px;padding:32px;background:var(--soft);border-radius:16px;scroll-margin-top:25px}.availability-heading{display:flex;align-items:center;gap:18px;margin-bottom:22px}.availability-heading img{object-fit:contain;flex-shrink:0}.availability h2{font-size:26px}.availability p{font-size:15px;line-height:1.65;color:var(--muted);margin-top:8px}.download-options{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.download-option{position:relative;display:flex;flex-direction:column;justify-content:center;gap:5px;min-height:90px;padding:17px 42px 17px 18px;border:1px solid var(--line);border-radius:11px;background:var(--surface);color:var(--ink);text-decoration:none}.download-option:hover{border-color:var(--accent);transform:translateY(-1px)}.option-label{font-size:16px;font-weight:650}.option-detail{font-size:12px;color:var(--muted)}.option-arrow{position:absolute;right:16px;top:17px;color:var(--accent)}.store-option{align-items:flex-start;border-color:var(--accent)}.app-store-badge{width:150px;height:auto;max-width:100%;object-fit:contain}.brew-option{padding:0;gap:8px}.brew-link{position:relative;display:block;padding:15px 42px 0 17px;color:var(--ink);text-decoration:none}.brew-link .option-arrow{top:16px}.brew-option code{padding:0 17px;color:var(--accent);font-size:11px;line-height:1.55;white-space:nowrap}.brew-option>.option-detail{padding:0 17px 14px}
  @media(max-width:1000px){.opening-copy{gap:35px}.opening-copy p{font-size:16px}.privacy-section{grid-template-columns:48px 1fr}.privacy-section>a{grid-column:2;max-width:none}.section-copy{gap:40px}.availability{margin-left:30px;margin-right:30px}.download-options{grid-template-columns:1fr 1fr}.brew-option{grid-column:1/-1}}
  @media(max-width:650px){.opening{padding:33px 16px 22px}.opening-copy{display:block;margin:0 7px 25px}.opening h1{font-size:37px}.opening-copy p{font-size:16px;margin-top:20px}.opening-copy a{font-size:13px;margin-top:12px}.opening-bottom{gap:14px;justify-content:space-between;flex-wrap:wrap;font-size:10px}.native-section{margin:60px auto;padding:0 23px}.section-copy{grid-template-columns:1fr;gap:20px}.section-copy h2{font-size:34px}.section-copy p{font-size:16px}.product-capture{padding:16px 13px 12px;border-radius:12px}.product-capture img{border-radius:4px}.product-capture figcaption{font-size:9px;margin-top:12px}.native-notes{grid-template-columns:1fr;gap:27px}.native-notes h3{font-size:23px}.native-notes p{font-size:15px}.privacy-section{padding:35px 23px;display:block}.privacy-icon{margin-bottom:20px}.privacy-section h2{font-size:29px}.privacy-section p{font-size:15px}.privacy-section>a{display:inline-block;margin-top:20px}.questions{grid-template-columns:1fr;gap:30px;margin:60px auto;padding:0 23px}.questions h2{font-size:33px}.faq-list summary{font-size:16px}.availability{margin:0 18px 40px;padding:22px}.availability-heading{align-items:flex-start;gap:14px}.availability-heading img{width:42px;height:42px}.availability h2{font-size:25px}.availability p{font-size:14px}.download-options{grid-template-columns:1fr}.download-option{min-height:80px}.brew-option{grid-column:auto}.brew-option code{font-size:11px}}
</style>

<style is:global>
  html.motion-ready .scroll-reveal{opacity:0;translate:0 16px;transition:opacity .55s cubic-bezier(.2,0,0,1),translate .55s cubic-bezier(.2,0,0,1);transition-delay:var(--reveal-delay,0ms)}
  html.motion-ready .scroll-reveal.is-visible{opacity:1;translate:none}
  .opening{position:relative;isolation:isolate;overflow:hidden}
  .opening::before{content:"";position:absolute;z-index:-1;inset:-28% -8% auto auto;width:min(72vw,900px);aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,rgba(99,190,255,.3),rgba(37,128,255,.12) 34%,transparent 68%);filter:blur(22px);animation:tavi-hero-drift 19s cubic-bezier(.4,0,.2,1) infinite alternate;pointer-events:none}
  .opening-copy a svg{transition:translate .2s cubic-bezier(.2,0,0,1)}
  .opening-copy a:hover svg{translate:0 4px}
  .platform-switch button{transition:background-color .2s,color .2s,translate .2s}
  .platform-switch button:active{translate:0 1px}
  .product-capture{transition:transform .35s cubic-bezier(.2,0,0,1),box-shadow .35s}
  .product-capture:hover{transform:translateY(-4px);box-shadow:0 18px 38px #29467520}
  .download-option{transition:transform .2s cubic-bezier(.2,0,0,1),border-color .2s,box-shadow .2s}
  .download-option:hover{transform:translateY(-2px);box-shadow:0 8px 20px #082b5815}
  @keyframes tavi-hero-drift{from{transform:translate3d(-1.5%,0,0) scale(.96);opacity:.72}to{transform:translate3d(1.5%,2%,0) scale(1.04);opacity:1}}
  @media(max-width:650px){.opening::before{width:110vw;inset:-15% -45% auto auto}}
  @media(prefers-reduced-motion:reduce){.opening::before{animation:none}.scroll-reveal{opacity:1!important;translate:none!important;transition:none!important}.opening-copy a svg,.platform-switch button,.product-capture,.download-option{transition:none}.product-capture:hover,.download-option:hover{transform:none;box-shadow:none}}
</style>
