---
import T from './ProposalText.astro';
---
<div class="playground" id="playground">
  <div class="demo-toolbar"><div class="workspace"><img src="/images/tavi/tavi-mark.png" width="22" height="22" alt=""/><strong>Demo API</strong></div><label class="environment"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c5 5 5 13 0 18-5-5-5-13 0-18Z"/></svg><select id="demo-environment" aria-label="Environment"><option value="global">Global</option><option value="local">Local</option></select></label><span class="demo-label"><T en="Interactive demo · simulated responses" es="Demo interactiva · respuestas simuladas"/></span></div>
  <div class="demo-columns">
    <aside class="folders"><T as="h2" en="Folders" es="Carpetas"/><button data-folder="users" aria-pressed="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h7l2 3h9v11H3Z"/></svg>Users</button><button data-folder="posts" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h7l2 3h9v11H3Z"/></svg>Posts</button><div class="variable-note"><span class="variable">baseUrl</span><code id="demo-base">https://demo.tavi.test</code><T as="p" en="Example variable. No network requests are sent." es="Variable de ejemplo. No se envían solicitudes a la red."/></div></aside>
    <aside class="request-list"><T as="h2" en="Requests" es="Solicitudes"/><div data-request-group="users"><button data-request="profile" aria-pressed="true"><span class="get-method">GET</span><T en="Get profile" es="Obtener perfil"/></button><button data-request="missing" aria-pressed="false"><span class="get-method">GET</span><T en="Missing user" es="Usuario inexistente"/></button></div><div data-request-group="posts" hidden><button data-request="posts" aria-pressed="false"><span class="get-method">GET</span><T en="List posts" es="Listar publicaciones"/></button><button data-request="create" aria-pressed="false"><span class="post-method">POST</span><T en="Create post" es="Crear publicación"/></button></div></aside>
    <div class="request-editor"><h2 id="demo-request-title"><T en="Get profile" es="Obtener perfil"/></h2><div class="url-line"><strong id="demo-method" class="get-method">GET</strong><div class="url-field"><span class="variable" title="Environment variable">baseUrl</span><code id="demo-path">/users/1</code></div><button class="send" id="demo-send"><T en="Send" es="Enviar"/><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 4 15 8-15 8 3-8-3-8Zm3 8h12"/></svg></button></div>
      <div class="editor-split"><section class="configuration" aria-label="Request configuration"><div class="config-tabs" role="group" aria-label="Request view"><button data-config="body" aria-pressed="false">Body</button><button data-config="params" aria-pressed="true">Params</button><button data-config="headers" aria-pressed="false">Headers</button><button data-config="auth" aria-pressed="false">Auth</button><button data-config="scripts" aria-pressed="false">Scripts</button></div>
        <div class="config-pane" data-pane="params"><div class="table-heading"><T en="Key" es="Clave"/><T en="Value" es="Valor"/></div><div class="param-row"><label for="demo-limit">_limit</label><input id="demo-limit" type="number" value="2" min="1" max="3"/></div><T as="p" class="pane-note" en="Choose List posts to try this parameter. Returns 1–3 example posts." es="Elige Listar publicaciones para probar este parámetro. Devuelve de 1 a 3 publicaciones de ejemplo."/></div>
        <div class="config-pane" data-pane="body" hidden><div id="demo-no-body"><T as="h3" en="No body for this request" es="Esta solicitud no tiene cuerpo"/><T as="p" en="Choose Create post to edit JSON and send a POST request." es="Elige Crear publicación para editar el JSON y enviar una solicitud POST."/></div><label id="demo-body-label" hidden><span>JSON</span><textarea id="demo-body" spellcheck="false" aria-label="JSON request body">{'{\n  "title": "Building Tavi",\n  "author": "Luis Gil",\n  "body": "A native workspace for APIs."\n}'}</textarea></label></div>
        <div class="config-pane" data-pane="headers" hidden><div class="table-heading"><T en="Key" es="Clave"/><T en="Value" es="Valor"/></div><div class="header-row"><span>Accept</span><code>application/json</code></div><div class="header-row"><span>Content-Type</span><code>application/json</code></div><T as="p" class="pane-note" en="Example headers for these JSON endpoints." es="Encabezados de ejemplo para estos endpoints JSON."/></div>
        <div class="config-pane" data-pane="auth" hidden><T as="h3" en="No authentication" es="Sin autenticación"/><T as="p" en="These demo endpoints need no credentials. In Tavi, you can configure Basic, Bearer or API key authentication." es="Estos endpoints de demostración no necesitan credenciales. En Tavi puedes configurar autenticación Basic, Bearer o API key."/></div>
        <div class="config-pane" data-pane="scripts" hidden><T as="h3" en="Scripts in the app" es="Scripts en la app"/><T as="p" en="The web demo doesn't execute scripts. Open Tavi to work with your request scripts." es="La demo web no ejecuta scripts. Abre Tavi para trabajar con los scripts de tus solicitudes."/></div>
      </section><section class="demo-response" aria-label="Response"><div class="response-heading"><T en="Response" es="Respuesta"/><span id="demo-status" role="status"><T en="Not sent" es="Sin enviar"/></span></div><div class="response-tabs" role="group" aria-label="Response view"><button data-view="body" aria-pressed="true">Body</button><button data-view="headers" aria-pressed="false">Headers</button></div><div class="response-scroll"><div id="demo-empty"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5-6 7 6 7m8-14 6 7-6 7M14 3l-4 18"/></svg><T as="h3" en="Ready to send" es="Lista para enviar"/><T as="p" en="Send a request to see Luis's sample data here." es="Envía una solicitud para ver aquí los datos de ejemplo de Luis."/></div><pre id="demo-result" hidden><code></code></pre></div></section></div>
      <div class="editor-bottom"><T en="Local simulation · no credentials needed" es="Simulación local · no requiere credenciales"/><kbd>⌘ / Ctrl + Enter</kbd></div>
    </div>
  </div>
</div>
<script>
  const root = document.querySelector<HTMLElement>('#playground')!;
  const $ = <T extends HTMLElement = HTMLElement>(s:string) => root.querySelector<T>(s)!;
  const spanish = () => document.documentElement.lang === 'es';
  const definitions:Record<string,{en:string;es:string;method:string;path:string}> = {
    profile:{en:'Get profile',es:'Obtener perfil',method:'GET',path:'/users/1'},
    missing:{en:'Missing user',es:'Usuario inexistente',method:'GET',path:'/users/404'},
    posts:{en:'List posts',es:'Listar publicaciones',method:'GET',path:'/posts'},
    create:{en:'Create post',es:'Crear publicación',method:'POST',path:'/posts'}
  };
  let request='profile', view='body', payload:unknown=null, statusCode=200, timer:ReturnType<typeof setTimeout>|undefined;
  const send=$<HTMLButtonElement>('#demo-send'), status=$('#demo-status'), result=$('#demo-result');
  const limit=$<HTMLInputElement>('#demo-limit');
  const posts=[{id:1,title:'Building Tavi',author:'Luis Gil'},{id:2,title:'A workspace for every API',author:'Luis Gil'},{id:3,title:'Native on Mac and iPad',author:'Luis Gil'}];
  function selectConfig(id:string){
    root.querySelectorAll<HTMLElement>('[data-pane]').forEach(el=>el.hidden=el.dataset.pane!==id);
    root.querySelectorAll('[data-config]').forEach(el=>el.setAttribute('aria-pressed',String((el as HTMLElement).dataset.config===id)));
  }
  function path(){ $('#demo-path').textContent=definitions[request].path+(request==='posts'?'?_limit='+limit.value:''); }
  function reset(){clearTimeout(timer);send.disabled=false;payload=null;result.hidden=true;$('#demo-empty').hidden=false;status.classList.remove('error');status.textContent=spanish()?'Sin enviar':'Not sent';}
  function selectRequest(id:string){
    request=id;reset();const def=definitions[id];$('#demo-request-title').textContent=spanish()?def.es:def.en;
    $('#demo-method').textContent=def.method;$('#demo-method').className=def.method==='GET'?'get-method':'post-method';path();
    root.querySelectorAll<HTMLElement>('[data-request]').forEach(el=>el.setAttribute('aria-pressed',String(el.dataset.request===id)));
    $('#demo-no-body').hidden=id==='create';$('#demo-body-label').hidden=id!=='create';
    limit.disabled=id!=='posts';selectConfig(id==='create'?'body':'params');
  }
  function render(){
    if(payload===null)return;
    status.textContent=statusCode===201?'201 Created':statusCode===404?'404 Not Found':statusCode===400?'400 Bad Request':'200 OK';
    status.classList.toggle('error',statusCode>=400);$('#demo-empty').hidden=true;result.hidden=false;
    const value=view==='body'?JSON.stringify(payload,null,2):'content-type: application/json\nx-tavi-demo: local-simulation\ncache-control: no-store';
    const code=result.querySelector('code')!;code.replaceChildren();
    value.split('\n').forEach(line=>{
      const row=document.createElement('span');row.className='code-line';
      // Tokens are rendered as text nodes, never interpreted as HTML.
      const regex=/("(?:\\.|[^"\\])*"\s*:?)|\b(true|false|null|\d+)\b/g;let start=0;
      for(const match of line.matchAll(regex)){row.append(document.createTextNode(line.slice(start,match.index)));const token=document.createElement('span');token.className=match[0].endsWith(':')?'json-key':match[1]?'json-string':'json-value';token.textContent=match[0];row.append(token);start=match.index!+match[0].length;}
      row.append(document.createTextNode(line.slice(start)||' '));code.append(row);
    });
  }
  send.addEventListener('click',()=>{
    if(request==='posts'&&!limit.reportValidity())return;
    send.disabled=true;status.textContent=spanish()?'Simulando…':'Simulating…';
    timer=setTimeout(()=>{
      statusCode=200;
      if(request==='profile')payload={id:1,name:'Luis Gil',username:'luisgildev',role:'Software developer',projects:['Tavi','NextUp','Umbral']};
      else if(request==='posts')payload=posts.slice(0,Number(limit.value));
      else if(request==='missing'){statusCode=404;payload={error:'user_not_found',message:spanish()?'Prueba Obtener perfil para encontrar a Luis.':'Choose Get profile to find Luis.'};}
      else {try {const body=JSON.parse($<HTMLTextAreaElement>('#demo-body').value);if(!body||typeof body!=='object'||Array.isArray(body)||typeof body.title!=='string'||!body.title.trim())throw new Error();payload={...body,id:4};statusCode=201;}catch{statusCode=400;payload={error:'invalid_json',message:spanish()?'Escribe un objeto JSON válido con un título no vacío.':'Enter a valid JSON object with a non-empty title.'};}}
      send.disabled=false;render();
    },250);
  });
  root.querySelectorAll<HTMLElement>('[data-folder]').forEach(button=>button.addEventListener('click',()=>{
    root.querySelectorAll<HTMLElement>('[data-folder]').forEach(el=>el.setAttribute('aria-pressed',String(el===button)));
    root.querySelectorAll<HTMLElement>('[data-request-group]').forEach(el=>el.hidden=el.dataset.requestGroup!==button.dataset.folder);
    selectRequest(button.dataset.folder==='users'?'profile':'posts');
  }));
  root.querySelectorAll<HTMLElement>('[data-request]').forEach(el=>el.addEventListener('click',()=>selectRequest(el.dataset.request!)));
  root.querySelectorAll<HTMLElement>('[data-config]').forEach(el=>el.addEventListener('click',()=>selectConfig(el.dataset.config!)));
  root.querySelectorAll<HTMLElement>('[data-view]').forEach(el=>el.addEventListener('click',()=>{view=el.dataset.view!;root.querySelectorAll('[data-view]').forEach(b=>b.setAttribute('aria-pressed',String(b===el)));render();}));
  limit.addEventListener('input',()=>{path();reset()});
  $<HTMLTextAreaElement>('#demo-body').addEventListener('input',reset);
  $<HTMLSelectElement>('#demo-environment').addEventListener('change',event=>{$('#demo-base').textContent=(event.target as HTMLSelectElement).value==='global'?'https://demo.tavi.test':'http://localhost:3000';reset()});
  root.addEventListener('keydown',event=>{if((event.metaKey||event.ctrlKey)&&event.key==='Enter'){event.preventDefault();if(!send.disabled)send.click()}});
  document.addEventListener('proposal-language',()=>{$('#demo-request-title').textContent=spanish()?definitions[request].es:definitions[request].en;if(payload!==null){if(statusCode===404)(payload as {message:string}).message=spanish()?'Prueba Obtener perfil para encontrar a Luis.':'Choose Get profile to find Luis.';if(statusCode===400)(payload as {message:string}).message=spanish()?'Escribe un objeto JSON válido con un título no vacío.':'Enter a valid JSON object with a non-empty title.';render()}else status.textContent=send.disabled?(spanish()?'Simulando…':'Simulating…'):(spanish()?'Sin enviar':'Not sent')});
  selectRequest('profile');
</script>
<style>
  .playground{--app:#fff;--app-bar:#f1f2f4;--app-sidebar:#f7f8fa;--app-line:#dfe2e7;--app-text:#293441;--app-muted:#5d6a78;--app-input:#f7f8fa;--app-selected:#0867ce;--code-key:#1753a8;--code-string:#286a35;--code-value:#7956a1;color:var(--app-text);background:var(--app);border-radius:12px;overflow:hidden;box-shadow:0 20px 45px #05276638;scroll-margin-top:24px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}
  :global([data-theme=dark]) .playground{--app:#242323;--app-bar:#302e2e;--app-sidebar:#292727;--app-line:#454141;--app-text:#f0eded;--app-muted:#b5b0b0;--app-input:#201f1f;--app-selected:#0061c7;--code-key:#82b7ff;--code-string:#a0d890;--code-value:#dcc0ff}
  .demo-toolbar{display:flex;align-items:center;gap:30px;min-height:50px;padding:10px 16px;background:var(--app-bar);border-bottom:1px solid var(--app-line);font-size:12px}.workspace{display:flex;align-items:center;gap:9px}.environment{display:flex;align-items:center;gap:6px;margin:auto;background:var(--app-input);border-radius:6px;padding:3px 8px}.environment select{border:0;background:transparent;font-size:11px;color:var(--app-text)}.environment svg{width:13px;height:13px}.demo-label{font-size:10px;color:var(--app-muted)}svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
  .demo-columns{display:grid;grid-template-columns:135px 157px minmax(0,1fr)}.folders,.request-list{padding:14px 8px;background:var(--app-sidebar);border-right:1px solid var(--app-line);min-width:0}.folders h2,.request-list h2{font-size:11px;font-weight:500;color:var(--app-muted);margin:0 6px 12px;letter-spacing:0}.folders button,.request-list button{width:100%;display:flex;align-items:center;gap:7px;border:0;padding:9px 7px;border-radius:5px;background:transparent;color:var(--app-text);font-size:11px;text-align:left;margin-bottom:3px}.folders button:hover,.request-list button:hover{background:var(--app-line)}.folders button[aria-pressed=true]{background:var(--app-line);font-weight:600}.folders svg{color:#2580d9;width:15px;height:15px}.request-list button[aria-pressed=true]{background:var(--app-selected);color:#fff}.request-list button[aria-pressed=true] .get-method{color:#c4ffd8}.request-list button[aria-pressed=true] .post-method{color:#ffe09c}.get-method{color:#268049}.post-method{color:#977017}.request-list .get-method,.request-list .post-method{font-size:9px;font-weight:650}.variable-note{margin:150px 6px 0;font-size:10px;color:var(--app-muted)}.variable-note code{display:block;font-size:9px;overflow-wrap:anywhere;margin-top:10px}.variable-note p{margin-top:10px;line-height:1.6}.variable{display:inline-block;border-radius:5px;background:#d9eaff;color:#194f9d;padding:2px 5px;font-family:ui-monospace,monospace;font-size:10px;white-space:nowrap}:global([data-theme=dark]) .variable{background:#29425e;color:#a9d0ff}
  .request-editor{min-width:0}.request-editor>h2{font-size:12px;letter-spacing:0;margin:14px 14px 8px}.url-line{display:flex;align-items:center;gap:7px;padding:0 12px 12px}.url-line>strong{font-size:10px}.url-field{display:flex;align-items:center;gap:2px;flex:1;min-width:0;background:var(--app-input);border:1px solid var(--app-line);border-radius:5px;padding:6px}.url-field code{font-size:11px;overflow-x:auto;white-space:nowrap}.send{background:var(--app-selected);color:#fff;border:0;border-radius:5px;padding:7px 10px;font-size:11px;display:flex;gap:7px;align-items:center}.send:hover{background:#0054b0}.send:disabled{opacity:.55}.send svg{width:13px;height:13px}.editor-split{display:grid;grid-template-columns:1fr 1fr;min-height:310px;border-top:1px solid var(--app-line)}.configuration{border-right:1px solid var(--app-line);min-width:0}.config-tabs{display:flex;gap:2px;background:var(--app-bar);padding:5px}.config-tabs button,.response-tabs button{flex:1;background:transparent;border:0;border-radius:4px;color:var(--app-text);padding:5px 3px;font-size:10px}.config-tabs button[aria-pressed=true],.response-tabs button[aria-pressed=true]{background:var(--app-selected);color:#fff}.config-pane{padding:14px 10px;font-size:11px;color:var(--app-muted);line-height:1.6}.config-pane h3{font-size:12px;color:var(--app-text);letter-spacing:0;margin:12px 0 9px}.table-heading,.param-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;align-items:center}.table-heading{padding:0 0 8px;border-bottom:1px solid var(--app-line);font-size:10px}.param-row{margin-top:10px}.param-row label{font-family:ui-monospace,monospace;color:var(--app-text)}.param-row input{background:var(--app-input);border:1px solid var(--app-line);border-radius:4px;width:100%;font-size:11px;padding:5px;color:var(--app-text)}.param-row input:disabled{opacity:.5}.pane-note{font-size:10px;margin-top:18px}.header-row{display:flex;justify-content:space-between;gap:8px;font-size:10px;margin-top:12px;flex-wrap:wrap}.header-row code{font-size:9px;color:var(--app-text)}textarea{display:block;width:100%;min-height:205px;resize:vertical;padding:10px 0;background:var(--app);color:var(--app-text);border:0;font:11px/1.7 ui-monospace,monospace;tab-size:2}#demo-body-label>span{font-size:10px}.demo-response{min-width:0}.response-heading{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:9px 12px;font-size:10px;border-bottom:1px solid var(--app-line)}#demo-status{font-size:9px;color:#287944}#demo-status.error{color:#b83229}:global([data-theme=dark]) #demo-status{color:#9cdda8}:global([data-theme=dark]) #demo-status.error{color:#ffb2a9}.response-tabs{display:flex;gap:5px;padding:5px 12px;width:145px}.response-scroll{max-height:310px;overflow:auto;padding:8px 12px}#demo-empty{text-align:center;padding:42px 6px;color:var(--app-muted)}#demo-empty svg{width:26px;height:26px;color:var(--app-muted);margin-bottom:10px}#demo-empty h3{font-size:13px;letter-spacing:0;color:var(--app-text)}#demo-empty p{font-size:11px;line-height:1.6;margin:10px auto 0;max-width:25ch}pre{margin:0;white-space:pre-wrap;overflow-wrap:anywhere;font:10px/1.7 ui-monospace,monospace;counter-reset:line}:global(.code-line){display:block;padding-left:26px;position:relative}:global(.code-line)::before{counter-increment:line;content:counter(line);position:absolute;left:0;width:18px;text-align:right;color:var(--app-muted);font-size:9px}:global(.json-key){color:var(--code-key)}:global(.json-string){color:var(--code-string)}:global(.json-value){color:var(--code-value)}.editor-bottom{display:flex;justify-content:space-between;gap:10px;padding:8px 12px;font-size:9px;color:var(--app-muted);border-top:1px solid var(--app-line);background:var(--app-sidebar)}kbd{font:inherit}
  @media(max-width:1100px){.demo-columns{grid-template-columns:105px 125px minmax(0,1fr)}.editor-split{grid-template-columns:1fr 1.05fr}.config-tabs{gap:0}.config-tabs button{font-size:9px;padding:6px 2px}.url-field code{font-size:10px}.demo-toolbar{gap:16px}.demo-label{font-size:9px}.request-list button{font-size:10px}}
  @media(max-width:850px){.demo-columns{grid-template-columns:115px minmax(0,1fr)}.folders{grid-column:1/-1;display:flex;align-items:center;gap:7px;border-right:0;border-bottom:1px solid var(--app-line);padding:7px 10px}.folders h2{margin:0 10px 0 0}.folders button{width:auto;margin:0;padding:6px 10px}.variable-note{display:none}.editor-bottom kbd{display:none}}
  @media(max-width:550px){.demo-toolbar{gap:10px;flex-wrap:wrap;padding:11px 12px}.environment{margin-left:auto;margin-right:0}.demo-label{width:100%;font-size:10px}.demo-columns{display:block}.folders h2{display:none}.request-list{border-right:0;border-bottom:1px solid var(--app-line);padding:7px 9px}.request-list h2{display:none}.request-list>div{display:flex;gap:6px}.request-list button{font-size:11px;width:auto;flex:1;margin:0;padding:9px 6px}.editor-split{display:block}.configuration{border-right:0;border-bottom:1px solid var(--app-line)}.config-tabs button{font-size:11px;padding:7px}.config-pane{padding:12px 15px;min-height:115px;font-size:12px}.config-pane h3{font-size:13px;margin-top:0}.pane-note{font-size:11px;margin-top:10px}.param-row{grid-template-columns:1fr 1fr}.url-line{gap:6px}.url-field{padding:6px 4px}.url-field code{font-size:10px}.send{padding:8px;font-size:11px}.send svg{display:none}.demo-response{min-height:225px}.response-heading{font-size:12px}.response-tabs button{font-size:11px}.response-scroll{max-height:280px;min-height:165px}pre{font-size:11px}#demo-empty{padding:20px 6px}#demo-status{font-size:10px}.editor-bottom{font-size:10px}.header-row{font-size:11px}}

  :global([data-theme=dark]) .get-method{color:#9cdda8}
  :global([data-theme=dark]) .post-method{color:#edcf88}
</style>
