---
import T from '../ProposalText.astro';
---
<header class="portfolio-hero" id="home">
  <canvas class="particle-wave" aria-hidden="true"></canvas>
  <div class="hero-content">
    <img class="hero-portrait" src="/images/profile/luis-gil.webp" width="640" height="800" alt="Luis Gil" decoding="async"/>
    <h1><T en="I'm Luis Gil." es="Soy Luis Gil."/><br/><T en="I build software" es="Creo software"/><br/><em><T en="with purpose." es="con propósito."/></em></h1>
    <T as="p" class="hero-description" en="Backend at IBM. Native apps of my own. Connecting systems, interfaces and the ideas in between." es="Backend en IBM. Apps nativas propias. Conectando sistemas, interfaces y las ideas que hay entre ellos."/>
    <div class="hero-actions"><a class="primary-action" href="#work"><T en="Explore my work" es="Explora mi trabajo"/><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg></a><a class="text-action" href="https://github.com/LuisGil15">GitHub <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg></a></div>
  </div>
  <div class="hero-foot"><code>Backend / Web / Native</code><a href="#work"><T en="Scroll to explore" es="Desliza para explorar"/><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v16m-6-6 6 6 6-6"/></svg></a></div>
</header>
<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.particle-wave');
  if (canvas) {
    const ctx = canvas.getContext('2d');
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let width = 0, height = 0, frame = 0;
    function draw(phase: number) {
      if (!canvas || !ctx) return;
      ctx.clearRect(0, 0, width, height);
      const dark = document.documentElement.dataset.theme === 'dark';
      for (let row = 0; row < 30; row++) {
        const depth = row / 29;
        for (let col = 0; col < 92; col++) {
          const x = (col / 91 * 1.24 - .12) * width;
          const wave = Math.sin(col * .065 + depth * 3.8 + phase) * 34 + Math.sin(col * .12 - depth * 2.5) * 17;
          const y = height * .71 + depth * height * .29 + wave * (1 - depth * .45);
          const alpha = (.14 + depth * .52) * (Math.sin(col / 91 * Math.PI) * .75 + .25);
          ctx.fillStyle = dark ? `rgba(175,220,214,${alpha})` : `rgba(20,99,112,${alpha * .75})`;
          ctx.beginPath(); ctx.arc(x, y, .55 + depth * .95, 0, Math.PI * 2); ctx.fill();
        }
      }
    }
    function render() {
      if (!canvas) return;
      const bounds = canvas.getBoundingClientRect();
      width = bounds.width; height = bounds.height;
      const ratio = Math.min(devicePixelRatio || 1, 2);
      canvas.width = Math.round(width * ratio); canvas.height = Math.round(height * ratio);
      ctx?.setTransform(ratio, 0, 0, ratio, 0, 0);
      draw(.8);
    }
    let phase = .8, visible = true, lastPaint = 0;
    function canAnimate() {
      return visible && !document.hidden && !reducedMotion.matches && document.documentElement.dataset.motion !== 'paused';
    }
    function tick(now: number) {
      frame = 0;
      if (!canAnimate()) return;
      if (now - lastPaint >= 32) {
        phase += Math.min((now - lastPaint) / 1000, .05) * .45;
        lastPaint = now;
        draw(phase);
      }
      frame = requestAnimationFrame(tick);
    }
    function sync() {
      cancelAnimationFrame(frame); frame = 0;
      draw(phase);
      if (canAnimate()) { lastPaint = performance.now(); frame = requestAnimationFrame(tick); }
    }
    const resize = new ResizeObserver(() => { render(); draw(phase); }); resize.observe(canvas);
    new MutationObserver(sync).observe(document.documentElement, {attributes:true, attributeFilter:['data-theme','data-motion']});
    reducedMotion.addEventListener('change', sync);
    document.addEventListener('visibilitychange', sync);
    new IntersectionObserver(entries => { visible = entries[0].isIntersecting; sync(); }, {rootMargin:'60px'}).observe(canvas);
    sync();
  }
</script>

<style>
 .hero-portrait { display:none; }
 @media(max-width:760px) { .hero-portrait { display:block; width:100px; height:118px; object-fit:cover; object-position:50% 12%; border-radius:14px; margin-bottom:25px; } }
</style>
