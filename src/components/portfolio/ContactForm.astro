---
import T from '../ProposalText.astro';
---
<form id="contact-form" class="contact-form" tabindex="-1" action="mailto:luis.gil.dev15@gmail.com" method="post" enctype="text/plain" aria-labelledby="contact-form-title">
  <T as="h3" id="contact-form-title" en="What do you want to build?" es="¿Qué quieres construir?"/>
  <T as="p" class="form-intro" en="Tell me what you want to solve, where things stand and how I could help. Projects, team opportunities and technical collaborations are welcome. Fields marked * are required." es="Cuéntame qué quieres resolver, en qué punto estás y cómo podría ayudarte. Podemos hablar de un proyecto, una oportunidad en tu equipo o una colaboración técnica. Los campos con * son obligatorios."/>
  <div class="contact-fields">
    <div class="contact-field"><label for="contact-name"><T en="Name" es="Nombre"/> <span aria-hidden="true">*</span></label><input id="contact-name" name="name" autocomplete="name" required maxlength="100"/></div>
    <div class="contact-field"><label for="contact-subject"><T en="Subject (optional)" es="Asunto (opcional)"/></label><input id="contact-subject" name="subject" maxlength="150"/></div>
    <div class="contact-field full-width"><label for="contact-message"><T en="Message" es="Mensaje"/> <span aria-hidden="true">*</span></label><textarea id="contact-message" name="message" rows="6" required maxlength="5000" data-placeholder-es="¡Hey! Vi tu trabajo y me encantaría trabajar contigo. Tengo una idea..." data-placeholder-en="Hey! I saw your work and would love to work with you. I have an idea..." placeholder={Astro.url.pathname.startsWith('/es/') ? '¡Hey! Vi tu trabajo y me encantaría trabajar contigo. Tengo una idea...' : 'Hey! I saw your work and would love to work with you. I have an idea...'}></textarea></div>
  </div>
  <div class="form-bottom"><T as="p" class="form-note" en="Prepare a draft, then open it in your email app to review and send it." es="Prepara un borrador y ábrelo en tu app de correo para revisarlo y enviarlo."/><button type="submit"><T en="Continue by email" es="Continuar por correo"/></button></div>
  <div class="draft-result" hidden>
    <p class="form-status" role="status" aria-live="polite" aria-atomic="true"></p>
    <a class="open-draft"><T en="Open draft in my email app" es="Abrir borrador en mi app de correo"/></a>
  </div>
  <noscript><p class="form-note"><T en="Without JavaScript, complete the form to continue in your email app." es="Sin JavaScript, completa el formulario para continuar en tu app de correo."/></p></noscript>
</form>
<script>
 import { buildContactEmail } from '../../scripts/contact-email';
 const form = document.querySelector<HTMLFormElement>('.contact-form');
 if (form) {
   const result = form.querySelector<HTMLElement>('.draft-result')!;
   const link = form.querySelector<HTMLAnchorElement>('.open-draft')!;
   const status = form.querySelector<HTMLElement>('.form-status')!;
   const clearDraft = () => { result.hidden=true; link.removeAttribute('href'); status.textContent=''; delete status.dataset.en; delete status.dataset.es; };
   form.addEventListener('input',event => {
     if (event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement) event.target.setCustomValidity('');
     clearDraft();
   });
   const message = form.querySelector<HTMLTextAreaElement>('#contact-message')!;
   const syncPlaceholder = () => { message.placeholder = document.documentElement.lang==='es' ? message.dataset.placeholderEs! : message.dataset.placeholderEn!; };
   syncPlaceholder();
   document.addEventListener('proposal-language',() => { syncPlaceholder(); clearDraft(); });
   form.addEventListener('submit',event => {
     event.preventDefault();
     const requiredText = form.querySelectorAll<HTMLInputElement|HTMLTextAreaElement>('#contact-name,#contact-message');
     requiredText.forEach(field => field.setCustomValidity(field.value.trim() ? '' : document.documentElement.lang==='es' ? 'Completa este campo.' : 'Please fill out this field.'));
     if (!form.reportValidity()) return;
     const data = new FormData(form);
     const language = document.documentElement.lang==='es' ? 'es' : 'en';
     link.href=buildContactEmail({name:String(data.get('name')||''),subject:String(data.get('subject')||''),message:String(data.get('message')||'')},language);
     status.dataset.en="Your draft is ready. Open it in your email app to review and send it. No message has been sent yet.";
     status.dataset.es='Tu borrador está listo. Ábrelo en tu app de correo para revisarlo y enviarlo. Todavía no se ha enviado ningún mensaje.';
     result.hidden=false;
     status.textContent=language==='es' ? status.dataset.es : status.dataset.en;
   });
 }
</script>
<style>
 .contact-form { scroll-margin-top:calc(var(--portfolio-header-height,70px) + 24px); margin-top:40px; padding-top:36px; border-top:1px solid var(--line); }
 .contact-form:focus { outline:none; }
 .contact-form h3 { font-size:clamp(22px,2.2vw,30px); font-weight:500; line-height:1.35; letter-spacing:-.025em; }
 .form-intro { max-width:62ch; margin-top:12px; font-size:13px; line-height:1.85; color:var(--muted); }
 .contact-fields { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:24px; margin-top:30px; }
 .contact-field { display:flex; flex-direction:column; gap:9px; min-width:0; }
 .full-width { grid-column:1/-1; }
 label { font-size:13px; color:var(--ink); line-height:1.6; }
 input,textarea { width:100%; min-width:0; border:1px solid var(--control-line); border-radius:10px; padding:14px 16px; background:var(--surface); color:var(--ink); font:inherit; font-size:16px; line-height:1.6; caret-color:var(--accent); scroll-margin-top:calc(var(--portfolio-header-height,70px) + 48px); }
 textarea::placeholder { color:var(--muted); opacity:1; }
 textarea { resize:vertical; min-height:160px; }
 input:focus-visible,textarea:focus-visible { outline:2px solid var(--accent); outline-offset:3px; }
 .form-bottom { display:flex; justify-content:space-between; align-items:center; gap:24px; margin-top:24px; }
 .form-note { color:var(--muted); font-size:11px; line-height:1.8; max-width:48ch; }
 button { flex-shrink:0; min-height:48px; border:1px solid transparent; border-radius:30px; padding:14px 24px; background:var(--ink); color:var(--page); font:inherit; font-size:13px; font-weight:550; cursor:pointer; }
 button:hover { background:var(--accent); color:var(--page); }
 .form-status { margin-top:18px; font-size:13px; line-height:1.85; overflow-wrap:anywhere; }
 .form-status:empty { display:none; }
 .draft-result { margin-top:24px; border-top:1px solid var(--line); padding-top:4px; }
 .draft-result[hidden] { display:none; }
 .open-draft { display:inline-flex; min-height:44px; align-items:center; margin-top:8px; color:var(--accent); font-size:13px; text-underline-offset:5px; }
 @media(max-width:760px) { .contact-fields { grid-template-columns:1fr; gap:20px; }.form-bottom { align-items:stretch; flex-direction:column; gap:18px; }.form-note { max-width:none; }.contact-form { margin-top:30px; padding-top:28px; } }
</style>
