---
import T from '../ProposalText.astro';
---
<section id="education" class="academic-section" aria-labelledby="education-title">
  <T as="h2" id="education-title" en="Education." es="Formación académica."/>
  <div class="academic-record">
    <svg viewBox="0 0 32 32" aria-hidden="true"><path d="m3 11 13-6 13 6-13 6-13-6Zm5 3v9c5 4 11 4 16 0v-9M29 11v12"/></svg>
    <div><T as="h3" en="Software Development Engineering" es="Ingeniería en Desarrollo de Software"/><p>CETI</p></div>
  </div>
</section>
<style>
 .academic-section { display:grid; grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr); gap:38px; align-items:start; padding-bottom:100px; }
 h2 { font-size:clamp(30px,3.1vw,48px); line-height:1.18; font-weight:500; letter-spacing:-.03em; }
 .academic-record { display:flex; gap:22px; align-items:flex-start; border-top:1px solid var(--line); padding-top:24px; }
 .academic-record svg { flex-shrink:0; width:38px; height:38px; color:var(--syntax-punctuation); }
 h3 { font-size:clamp(23px,2.2vw,30px); line-height:1.4; font-weight:500; letter-spacing:-.025em; }
 p { color:var(--accent); font-size:15px; line-height:1.8; margin-top:12px; }
 @media(max-width:1150px) { .academic-section { grid-template-columns:1fr; gap:28px; } }
 @media(max-width:760px) { .academic-section { padding-bottom:65px; gap:26px; }h2 { font-size:32px; }.academic-record { gap:18px; }.academic-record svg { width:30px; height:30px; }h3 { font-size:25px; } }
</style>
