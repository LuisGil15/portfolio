---
const { variant = 'page' } = Astro.props;
const networks = [
 {id:'github',name:'GitHub',url:'https://github.com/LuisGil15'},
 {id:'linkedin',name:'LinkedIn',url:'https://www.linkedin.com/in/luis-francisco-gil-perez-721348182/'},
 {id:'instagram',name:'Instagram',url:'https://www.instagram.com/luisgildev/'},
 {id:'threads',name:'Threads',url:'https://www.threads.com/@luisgildev'},
 {id:'x',name:'X',url:'https://x.com/luisgildev'},
];
---
<div class:list={['socials',{'profile-socials':variant==='profile'}]}>
 {networks.map(network => <a class="social-icon" href={network.url} target="_blank" rel="noopener noreferrer" aria-label={network.name} title={network.name}><img src={`/images/social-icons/${network.id}.svg`} width="18" height="18" alt=""/></a>)}
</div>
<style>
 .socials { display:flex; flex-wrap:wrap; gap:8px; }
 .social-icon { display:inline-flex; align-items:center; justify-content:center; width:40px; height:40px; border:0; border-radius:0; color:var(--ink); }
 .social-icon img { display:block; width:18px; height:18px; object-fit:contain; }
 :global([data-theme=dark]) .social-icon img { filter:invert(1); }
 .profile-socials { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:6px; }
 .profile-socials .social-icon { width:100%; height:36px; }
 .profile-socials .social-icon img { filter:invert(1); }
 .socials a:hover { opacity:.7; }
 @media(max-width:760px) { .profile-socials { display:none; } }
</style>
