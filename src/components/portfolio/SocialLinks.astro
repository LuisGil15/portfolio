---
const { variant = 'page' } = Astro.props;
const networks = [
 {id:'github',name:'GitHub',url:'https://github.com/LuisGil15'},
 {id:'linkedin',name:'LinkedIn',url:'https://www.linkedin.com/in/luis-francisco-gil-perez-721348182/'},
 {id:'facebook',name:'Facebook'}, {id:'instagram',name:'Instagram'},
 {id:'threads',name:'Threads'}, {id:'x',name:'X'},
];
---
<div class:list={['socials',{'profile-socials':variant==='profile'}]}>
 {networks.map(network => network.url
  ? <a class="social-icon" href={network.url} target="_blank" rel="noopener noreferrer" aria-label={network.name} title={network.name}><img src={`/images/social-icons/${network.id}.svg`} width="18" height="18" alt=""/></a>
  : <span class="social-icon social-placeholder" role="img" aria-label={network.name} title={network.name}><img src={`/images/social-icons/${network.id}.svg`} width="18" height="18" alt=""/></span>)}
</div>
<style>
 .socials { display:flex; flex-wrap:wrap; gap:8px; }
 .social-icon { display:inline-flex; align-items:center; justify-content:center; width:40px; height:40px; border:1px solid var(--line); border-radius:50%; color:var(--ink); }
 .social-icon img { display:block; width:18px; height:18px; object-fit:contain; }
 :global([data-theme=dark]) .social-icon img { filter:invert(1); }
 .profile-socials { display:grid; grid-template-columns:repeat(6,minmax(0,1fr)); gap:6px; }
 .profile-socials .social-icon { width:100%; height:36px; border-color:var(--profile-line); }
 .profile-socials .social-icon img { filter:invert(1); }
 .socials a:hover { border-color:var(--accent); background:var(--soft); }
 .profile-socials a:hover { border-color:var(--profile-muted); background:#23454a; }
 .social-placeholder { opacity:.65; }
 @media(max-width:760px) { .profile-socials { display:none; } }
</style>
