---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Página no encontrada" description="La página solicitada no existe.">
  <section class="legal-copy">
    <p class="eyebrow">Error 404</p>
    <h1>Esta página no existe.</h1>
    <p class="lede">Puede que la dirección haya cambiado o que el enlace esté incompleto.</p>
    <div class="actions">
      <a class="button primary" href="/">Volver al portafolio</a>
    </div>
  </section>
</SiteLayout>
