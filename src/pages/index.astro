---
import SiteLayout from "../layouts/SiteLayout.astro";
import { apps } from "../data/apps";
---

<SiteLayout
  title="Luis Gil — Software independiente"
  description="Portafolio de Luis Gil y hogar de sus aplicaciones independientes."
>
  <section>
    <p class="eyebrow">Software independiente</p>
    <h1>Herramientas hechas para sentirse en casa.</h1>
    <p class="lede">
      Diseño y desarrollo productos enfocados, rápidos y respetuosos con la privacidad.
      Este sitio reúne mis aplicaciones y la información necesaria para usarlas.
    </p>
  </section>

  <section class="section" aria-labelledby="apps-title">
    <p class="eyebrow">Aplicaciones</p>
    <h2 id="apps-title">Productos en desarrollo</h2>
    <div class="card-grid">
      {apps.map((app) => (
        <a class="card" href={`/apps/${app.slug}/`}>
          <h3>{app.name}</h3>
          <p>{app.description}</p>
          <ul class="tag-list" aria-label={`Plataformas de ${app.name}`}>
            {app.platforms.map((platform) => <li>{platform}</li>)}
          </ul>
        </a>
      ))}
    </div>
  </section>
</SiteLayout>
