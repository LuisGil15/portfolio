---
import { tavi } from "../../../data/apps";
import AppLayout from "../../../layouts/AppLayout.astro";
---

<AppLayout app={tavi}>
  <section>
    <p class="eyebrow">Tavi para macOS y iPadOS</p>
    <h1>{tavi.tagline}</h1>
    <p class="lede">{tavi.description}</p>
    <div class="actions">
      <span class="button primary" aria-disabled="true">{tavi.status}</span>
      <a class="button" href="/apps/tavi/privacy/">Privacidad</a>
      <a class="button" href="/apps/tavi/support/">Soporte</a>
    </div>
  </section>

  <section class="section" aria-labelledby="features-title">
    <p class="eyebrow">Fundamentos</p>
    <h2 id="features-title">Pensado para trabajo real</h2>
    <div class="card-grid">
      {tavi.features.map((feature) => (
        <article class="card">
          <h3>{feature.title}</h3>
          <p>{feature.description}</p>
        </article>
      ))}
    </div>
  </section>
</AppLayout>
