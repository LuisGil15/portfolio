---
import type { AppDefinition, AppSection } from "../data/apps/types";
import SiteLayout from "./SiteLayout.astro";

interface Props {
  app: AppDefinition;
  activeSection?: AppSection;
  title?: string;
  description?: string;
}

const {
  app,
  activeSection = "overview",
  title = app.metaTitle,
  description = app.description,
} = Astro.props;
---

<SiteLayout title={title} description={description}>
  <header class="app-header">
    <a class="app-identity" href={`/apps/${app.slug}/`}>
      <strong>{app.name}</strong>
      <span>{app.status}</span>
    </a>

    <nav class="app-nav" aria-label={`Secciones de ${app.name}`}>
      {app.navigation.map((item) => (
        <a href={item.path} aria-current={activeSection === item.id ? "page" : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
  </header>

  <slot />
</SiteLayout>
