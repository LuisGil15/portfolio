---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  portfolioNav?: boolean;
  lang?: "en" | "es";
  languageHref?: string;
  pageClass?: string;
}

const {
  title,
  description,
  portfolioNav = false,
  lang = "es",
  languageHref,
  pageClass,
} = Astro.props;
const path = Astro.url.pathname;
const canonicalURL = new URL(path, Astro.site ?? Astro.url.origin);
const isSpanish = lang === "es";
const alternateURL = languageHref ? new URL(languageHref, Astro.site ?? Astro.url.origin) : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="theme-color" content="#0d0e11" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f5f7" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    {alternateURL && <link rel="alternate" hreflang={isSpanish ? "en" : "es"} href={alternateURL} />}
    {portfolioNav && <link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site ?? Astro.url.origin)} />}
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{isSpanish ? "Saltar al contenido" : "Skip to content"}</a>
    <header class:list={["site-header", { "portfolio-header": portfolioNav }]}>
      {!portfolioNav && (
        <a class="brand" href="/" aria-label={isSpanish ? "Inicio" : "Home"}>
          <span class="brand-mark" aria-hidden="true">LG</span>
        </a>
      )}
      <nav aria-label={isSpanish ? "Navegación principal" : "Main navigation"}>
        {portfolioNav ? (
          <>
            <a href="#aplicaciones">Apps</a>
            <a href="#experiencia">{isSpanish ? "Experiencia" : "Experience"}</a>
            <a href="#proyectos">{isSpanish ? "Proyectos" : "Projects"}</a>
            <a href="#contacto">{isSpanish ? "Contacto" : "Contact"}</a>
            {languageHref && (
              <a
                class="language-switch"
                href={languageHref}
                hreflang={isSpanish ? "en" : "es"}
                lang={isSpanish ? "en" : "es"}
                data-language-switch
                aria-label={isSpanish ? "Switch to English" : "Cambiar a español"}
              >
                {isSpanish ? "EN" : "ES"}
              </a>
            )}
          </>
        ) : (
          <>
            <a href="/" aria-current={path === "/" ? "page" : undefined}>{isSpanish ? "Portafolio" : "Portfolio"}</a>
            <a href="/apps/" aria-current={path.startsWith("/apps/") ? "page" : undefined}>{isSpanish ? "Aplicaciones" : "Apps"}</a>
          </>
        )}
      </nav>
    </header>

    <main id="main-content" class:list={{ "portfolio-main": portfolioNav, [pageClass ?? ""]: Boolean(pageClass) }}>
      <slot />
    </main>

    <footer class="site-footer">
      <span>{isSpanish ? "Hecho con" : "Made with"} <span aria-label={isSpanish ? "amor" : "love"}>♥</span> {isSpanish ? "por" : "by"} Luis Gil</span>
      <span class="footer-domain">luisgil.org · 2026</span>
    </footer>

    {languageHref && (
      <script is:inline>
        document.querySelectorAll("[data-language-switch]").forEach((link) => {
          const updateLanguageLink = () => {
            const target = new URL(link.getAttribute("href"), window.location.origin);
            target.hash = window.location.hash;
            link.setAttribute("href", `${target.pathname}${target.hash}`);
          };

          updateLanguageLink();
          window.addEventListener("hashchange", updateLanguageLink);
        });
      </script>
    )}
  </body>
</html>
