---
import type { AppDefinition, AppSection } from "../data/apps/types";
import AppLayout from "./AppLayout.astro";

interface Props {
  app: AppDefinition;
  activeSection: AppSection;
  heading: string;
  description: string;
  lastUpdated?: string;
}

const { app, activeSection, heading, description, lastUpdated } = Astro.props;
---

<AppLayout
  app={app}
  activeSection={activeSection}
  title={`${heading} de ${app.name}`}
  description={description}
>
  <article class="legal-copy">
    <p class="eyebrow">{app.name}</p>
    <h1>{heading}</h1>
    {lastUpdated && <p class="legal-meta" data-es="Vigente desde el 6 de octubre de 2026.">Effective October 6, 2026.</p>}
    <slot />
  </article>
</AppLayout>
