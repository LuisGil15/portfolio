    "themes": {
      "selector": "html[data-theme=dark]",
      "storageKey": "site-theme:<scope>",
      "storageKeys": { "portfolio": "site-theme:portfolio", "tavi": "site-theme:tavi" },
      "fallback": "Portfolio light; Tavi and its documents dark. Independent of system preference; the old shared key is ignored.",
      "portfolio": "body.portfolio overrides the shared semantic roles in light and dark modes.",
      "demo": "Local --app-* and --code-* variables in TaviPlayground track the same theme while retaining native-style graphite surfaces.",
      "componentPreviews": "Previews use semantic CSS custom properties with light-state fallbacks. Runtime component overrides provide full dark states; primitive frontmatter component variants describe light defaults."
    },
    "shadows": [
