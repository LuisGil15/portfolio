  "components": [
    {
      "name": "Portfolio Project Link",
      "kind": "button",
      "refersTo": "portfolio-project-link",
      "description": "White project action with a teal theme-aware hover.",
      "html": "<a class=\"ds-project-link\" href=\"#tavi\">Meet Tavi <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></a>",
      "css": ".ds-project-link{display:inline-flex;align-items:center;gap:16px;font:600 12px/1.5 Sora,sans-serif;color:#193c43;background:#fff;border-radius:8px;padding:11px 15px;text-decoration:none}.ds-project-link svg{fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}.ds-project-link:hover{background:var(--button,#146370);color:#fff}.ds-project-link:focus-visible,.ds-contact:focus-visible,.ds-filter:focus-visible,.ds-nav a:focus-visible,.ds-send:focus-visible,.ds-param input:focus-visible{outline:3px solid #e05116;outline-offset:5px}"
    },
    {
      "name": "Portfolio Contact Action",
      "kind": "button",
      "refersTo": "portfolio-contact",
      "description": "Filled contact action using the current theme's button and hover roles.",
      "html": "<a class=\"ds-contact\" href=\"#contact\">Start a conversation</a>",
      "css": ".ds-contact{display:inline-block;font:400 12px/1.5 Sora,sans-serif;background:var(--button,#146370);color:#fff;padding:12px 17px;border-radius:8px;text-decoration:none}.ds-contact:hover{background:var(--button-hover,#0d4d58)}.ds-project-link:focus-visible,.ds-contact:focus-visible,.ds-filter:focus-visible,.ds-nav a:focus-visible,.ds-send:focus-visible,.ds-param input:focus-visible{outline:3px solid #e05116;outline-offset:5px}"
    },
    {
      "name": "Portfolio Filter",
      "kind": "chip",
      "refersTo": "portfolio-filter-selected",
      "description": "Pressed gallery filter uses the about surface and text accent.",
      "html": "<button class=\"ds-filter\" aria-pressed=\"true\">All work</button>",
      "css": ".ds-filter{border:0;background:transparent;color:var(--muted,#526e74);font:400 12px/1.5 Sora,sans-serif;padding:9px 12px;border-radius:7px;cursor:pointer}.ds-filter[aria-pressed=true]{background:var(--about,#d9ebed);color:var(--accent,#146370)}.ds-filter:hover{background:var(--soft,#e4eff0)}.ds-project-link:focus-visible,.ds-contact:focus-visible,.ds-filter:focus-visible,.ds-nav a:focus-visible,.ds-send:focus-visible,.ds-param input:focus-visible{outline:3px solid #e05116;outline-offset:5px}"
    },
    {
      "name": "Portfolio Navigation",
      "kind": "nav",
      "description": "Flat links on the petroleum identity surface; horizontal on mobile.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Portfolio preview\"><a class=\"ds-current\" href=\"#work\">My work</a><a href=\"#experience\">Experience</a><a href=\"#about\">About me</a></nav>",
      "css": ".ds-nav{display:grid;gap:10px;background:var(--sidebar,#145867);color:#fff;padding:20px;font:400 14px/1.5 Sora,sans-serif}.ds-nav a{padding:12px 14px;text-decoration:none;color:inherit;border-radius:8px}.ds-nav a:hover,.ds-nav .ds-current{background:var(--sidebar-hover,#216d7c)}@media(max-width:720px){.ds-nav{display:flex;gap:8px}.ds-nav a{font-size:11px;padding:8px 10px}}.ds-project-link:focus-visible,.ds-contact:focus-visible,.ds-filter:focus-visible,.ds-nav a:focus-visible,.ds-send:focus-visible,.ds-param input:focus-visible{outline:3px solid #e05116;outline-offset:5px}"
    },
    {
      "name": "Tavi Send Request",
      "kind": "button",
      "refersTo": "tavi-send",
      "description": "Compact native-like Send control; disabled during local simulation.",
      "html": "<button class=\"ds-send\">Send <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m4 4 17 8-17 8 3-8-3-8Zm3 8h14\"/></svg></button>",
      "css": ".ds-send{display:flex;align-items:center;gap:7px;background:var(--app-selected,#0867ce);color:#fff;border:0;border-radius:5px;padding:7px 10px;font:400 11px/1.5 -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;cursor:pointer}.ds-send svg{fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}.ds-send:hover{background:#0054b0}.ds-send:disabled{opacity:.55;cursor:wait}.ds-project-link:focus-visible,.ds-contact:focus-visible,.ds-filter:focus-visible,.ds-nav a:focus-visible,.ds-send:focus-visible,.ds-param input:focus-visible{outline:3px solid #e05116;outline-offset:5px}"
    },
    {
      "name": "Tavi Request Parameter",
      "kind": "input",
      "description": "Editable parameter field embedded in the request configuration view.",
      "html": "<label class=\"ds-param\"><span>limit</span><input aria-label=\"Post limit\" type=\"number\" min=\"1\" max=\"3\" value=\"3\"/></label>",
      "css": ".ds-param{display:grid;grid-template-columns:1fr 1fr;gap:10px;align-items:center;font:400 11px/1.5 ui-monospace,monospace;color:var(--app-text,#293441)}.ds-param input{background:var(--app-input,#f7f8fa);border:1px solid var(--app-line,#dfe2e7);border-radius:4px;width:100%;font:400 11px/1.5 -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;padding:5px;color:var(--app-text,#293441)}.ds-param input:disabled{opacity:.5}.ds-project-link:focus-visible,.ds-contact:focus-visible,.ds-filter:focus-visible,.ds-nav a:focus-visible,.ds-send:focus-visible,.ds-param input:focus-visible{outline:3px solid #e05116;outline-offset:5px}"
    },
    {
      "name": "Tavi Workspace",
      "kind": "card",
      "refersTo": "tavi-workspace",
      "description": "Native-style toolbar and response surface; this compact preview is illustrative, not the complete interactive demo.",
      "html": "<section class=\"ds-workspace\"><div class=\"ds-workspace-top\"><strong>Tavi</strong><span>Local simulation · sample data</span></div><div class=\"ds-workspace-body\"><span class=\"ds-success\">200 OK</span><pre>{\n  &quot;name&quot;: &quot;Luis Gil&quot;\n}</pre></div></section>",
      "css": ".ds-workspace{background:var(--app,#fff);color:var(--app-text,#293441);border-radius:12px;overflow:hidden;box-shadow:0 20px 45px #05276638;font:400 12px/1.5 -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}.ds-workspace-top{background:var(--app-bar,#f1f2f4);display:flex;align-items:center;justify-content:space-between;padding:10px 16px;gap:30px;min-height:50px;border-bottom:1px solid var(--app-line,#dfe2e7)}.ds-workspace-top>span{font-size:10px;color:var(--app-muted,#5d6a78)}.ds-workspace-body{padding:8px 12px}.ds-success{font-size:9px;color:#287944}.ds-workspace pre{font:400 10px/1.7 ui-monospace,monospace;white-space:pre-wrap;overflow-wrap:anywhere}"
    }
  ],
  "narrative": {
    "northStar": "Tangible software, two independent worlds",
    "overview": "The approved portfolio and Tavi compositions now serve the production routes in the local implementation. The portfolio is an artifact-led gallery with a petroleum teal identity; Tavi is a clear technical workspace held inside a broad blue field. Both use real software evidence and purposeful interaction to make the work understandable.\n\nThis existing documentation boundary is retained for provenance, but its current authority covers /, /es/, /apps/tavi/ and the Tavi document pages. Legacy proposal routes render the shared adopted components. Shared semantic light/dark tokens and language controls connect these surfaces without erasing their distinct identities.",
    "keyCharacteristics": [
      "Two distinct palettes and type families, with shared theme and language behavior.",
      "Real Tavi imagery and explicitly labeled illustrative interactions.",
      "Quiet rounded surfaces with shadows reserved for software and device artifacts.",
      "English and Spanish layouts with visible keyboard focus and reduced-motion support."
    ],
    "rules": [
      {
        "name": "The Independent Worlds Rule",
        "body": "Keep petroleum teal for the portfolio and blue for Tavi; share semantic behavior and components without flattening their identities.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do preserve the approved compositions and the portfolio's petroleum teal identity.",
      "Do reuse the real Tavi mark and screenshots and label illustrative demonstrations.",
      "Do preserve English and Spanish content, light and dark states, and keyboard access.",
      "Do use response text as well as color to distinguish success and error."
    ],
    "donts": [
      "Don't restore the superseded purple portfolio identity.",
      "Don't imply that the local request simulation is a live API or the native application.",
      "Don't invent customers, usage statistics, prices, testimonials, or release claims."
    ]
  }
}
