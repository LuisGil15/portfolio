    "motion": [
      {"name": "minitools-hover-intent", "value": "120ms intent; 220ms exit; no width interpolation", "purpose": "Keep pointer targets stable; focus/click pin compact controls, and the first-click origin guard preserves the intended opening gesture. Reduced motion stops the waveform."},
